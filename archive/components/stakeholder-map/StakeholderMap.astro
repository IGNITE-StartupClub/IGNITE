---
import StakeholderDetail from './StakeholderDetail.astro';
import LiquidEther from '../LiquidEther/LiquidEther.jsx';

interface Stakeholder {
    name: string;
    offerName: string;
    offerDescription: string;
    description: string;
    link: string;
    journeyPhase: string;
    fullDescription: string;
    logo?: string;
    contact: {
        email?: string;
        phone?: string;
        website?: string;
        address?: string;
    };
    help: string[];
}

// Beispiel-Daten mit Journey-Phasen
const stakeholders: Stakeholder[] = [
    {
        name: "IGNITE Startup Club",
        offerName: "Startup Community",
        offerDescription: "Eine lebendige Community für angehende Gründer:innen. Wir bieten regelmäßige Networking-Events, Workshops und Mentoring in einem unterstützenden studentischen Umfeld.",
        description: "Community & erste Vernetzung",
        link: "https://ignite-startupclub.de",
        journeyPhase: "Ideenfindung",
        fullDescription: "Der studentische Startup Club der Leuphana Universität Lüneburg. Wir vernetzen Gründungsinteressierte und organisieren regelmäßig Events, Workshops und Networking-Sessions. Bei uns triffst du Gleichgesinnte, lernst von erfahrenen Gründer:innen und kannst deine Ideen in einem unterstützenden Umfeld weiterentwickeln.",
        contact: {
            email: "hello@ignite-startupclub.de",
            website: "ignite-startupclub.de"
        },
        help: [
            "Community Building & Networking",
            "Peer-to-Peer Mentoring",
            "Workshops zu Gründungsthemen",
            "Zugang zu Events & Pitch-Nights",
            "Erste Kontakte im Startup-Ökosystem"
        ]
    },
    {
        name: "Leuphana E-Hub",
        offerName: "Gründungsberatung & Coworking",
        offerDescription: "Professionelle Erstberatung und Zugang zu modernen Coworking-Spaces in der Gründungsgarage. Wir bieten individuelles Coaching und vermitteln zu relevanten Förderpartnern.",
        description: "Beratung & Gründungsgarage",
        link: "https://leuphana.de/einrichtungen/gruendungsservice",
        journeyPhase: "Ideenfindung",
        fullDescription: "Die zentrale Anlaufstelle für alle Gründungsinteressierten an der Leuphana. Der E-Hub bietet kostenlose Erstberatung, Zugang zur Gründungsgarage mit Coworking-Spaces und professionelles Coaching. Hier bekommst du die Unterstützung, die du brauchst, um deine Idee zum Leben zu erwecken.",
        contact: {
            email: "gruendungsservice@leuphana.de",
            website: "leuphana.de/einrichtungen/gruendungsservice",
            address: "Gründungsgarage, Scharnhorststraße"
        },
        help: [
            "Kostenlose Erstberatung",
            "Zugang zu Coworking-Spaces",
            "Professionelles Coaching",
            "Gründungsgarage-Mitgliedschaft",
            "Vermittlung zu Förderpartnern"
        ]
    },
    {
        name: "IHK Lüneburg-Wolfsburg",
        offerName: "Businessplan-Beratung & Netzwerk",
        offerDescription: "Umfassende Unterstützung bei allen formalen und rechtlichen Fragen der Gründung. Von der Businessplan-Prüfung bis zur Vermittlung von Kontakten zu etablierten Unternehmen.",
        description: "Gründungsberatung & Netzwerk",
        link: "https://www.ihk.de/lueneburg-wolfsburg",
        journeyPhase: "Team Building",
        fullDescription: "Die Industrie- und Handelskammer bietet umfassende Beratung für Gründer:innen in der Region. Von rechtlichen Fragen über Businessplan-Erstellung bis hin zur Vermittlung von Kontakten zu etablierten Unternehmen – die IHK ist dein Partner für professionelle Gründungsbegleitung.",
        contact: {
            phone: "04131 742-0",
            website: "www.ihk.de/lueneburg-wolfsburg"
        },
        help: [
            "Gründungsberatung & Businessplan-Check",
            "Rechtsberatung & Formalitäten",
            "Netzwerkvermittlung zu Unternehmen",
            "Fördermittelberatung",
            "Weiterbildungsangebote"
        ]
    },
    {
        name: "EXIST-Gründerstipendium",
        offerName: "Gründerstipendium",
        offerDescription: "Finanzielle Förderung für bis zu ein Jahr durch das Bundesministerium für Wirtschaft und Klimaschutz. Unterstützt innovative technologieorientierte und wissensbasierte Gründungsvorhaben mit Lebensunterhalt, Coaching und Sachausgaben.",
        description: "Finanzielle Förderung",
        link: "https://www.exist.de",
        journeyPhase: "Finanzierung",
        fullDescription: "Das Förderprogramm des Bundesministeriums für Wirtschaft und Klimaschutz unterstützt innovative technologieorientierte und wissensbasierte Gründungsvorhaben. Mit bis zu einem Jahr finanzieller Förderung, Coaching und Sachausgaben kannst du dich voll auf deine Gründung konzentrieren.",
        contact: {
            website: "www.exist.de",
            email: "gruendungsservice@leuphana.de"
        },
        help: [
            "Finanzielle Förderung (bis zu 1 Jahr)",
            "Lebensunterhalt-Stipendium",
            "Coaching & Mentoring",
            "Sachausgaben für Material",
            "Beratung über Leuphana Gründungsservice"
        ]
    },
    {
        name: "Business Angels Netzwerk",
        offerName: "Seed-Finanzierung & Mentoring",
        offerDescription: "Erfahrene Unternehmer:innen und Investor:innen, die Startups mit Kapital und Know-how unterstützen. Neben der Seed-Finanzierung bieten Business Angels strategisches Mentoring, Netzwerkzugang und hands-on Unterstützung.",
        description: "Private Investor:innen",
        link: "https://www.business-angels.de",
        journeyPhase: "Skalierung",
        fullDescription: "Netzwerk erfahrener Unternehmer:innen und Investor:innen, die Startups mit Kapital und Know-how unterstützen. Business Angels investieren nicht nur Geld, sondern bringen auch ihre Expertise, Kontakte und Erfahrung ein, um dein Startup zum Erfolg zu führen.",
        contact: {
            website: "www.business-angels.de"
        },
        help: [
            "Seed-Finanzierung",
            "Strategisches Mentoring",
            "Netzwerkzugang & Türöffner",
            "Hands-on Unterstützung",
            "Kontakt über Gründungsservice"
        ]
    },
];
---

<div class="timeline-container w-full relative">
    <!-- Liquid Ether Background -->
    <div class="liquid-background-wrapper">
        <LiquidEther
            client:load
            colors={['#6341A5', '#8C3974', '#B19EEF']}
            mouseForce={30}
            cursorSize={120}
            autoSpeed={0.1}
            autoIntensity={2.5}
            resolution={0.8}
            style={{ opacity: 0.7 }}
        />
    </div>

    <div class="background relative w-screen h-[40vh] md:h-[50vh] flex items-center overflow-hidden">
        
        <!-- Scrollable Container -->
        <div 
            id="stakeholderScroll"
            class="stakeholder-scroll-container absolute inset-0 flex items-center overflow-x-auto overflow-y-hidden snap-x snap-mandatory scrollbar-hide"
        >
            {stakeholders.map((stakeholder, index) => (
                <div class="stakeholder-slide flex-shrink-0 w-screen flex items-center justify-center snap-center relative">
                    <!-- Previous Ghost (Left) -->
                    {index > 0 && (
                        <div class="ghost-left absolute left-4 md:left-16 opacity-10 pointer-events-none">
                            <div class="stakeholder-group flex flex-col md:flex-row gap-2 md:gap-4 items-center md:items-start scale-75 md:scale-90">
                                {stakeholders[index - 1].logo ? (
                                    <img src={stakeholders[index - 1].logo} alt={stakeholders[index - 1].name} class="w-16 h-16 md:w-20 md:h-20 flex-shrink-0 object-contain" />
                                ) : (
                                    <div class="w-16 h-16 md:w-20 md:h-20 flex-shrink-0 rounded-full bg-white/10 flex items-center justify-center">
                                        <span class="text-white text-xl md:text-2xl font-bold">{stakeholders[index - 1].name.charAt(0)}</span>
                                    </div>
                                )}
                                <div class="flex flex-col justify-center max-w-xs text-center md:text-left">
                                    <h2 class="text-white font-bold text-sm md:text-lg">{stakeholders[index - 1].offerName}</h2>
                                    <p class="text-white/70 text-xs md:text-sm">{stakeholders[index - 1].name}</p>
                                </div>
                            </div>
                        </div>
                    )}

                    <!-- Current Stakeholder -->
                    <div class="stakeholder-wrapper transition-all duration-500 opacity-100 px-4">
                        <div class="stakeholder-group flex flex-col md:flex-row gap-4 items-center md:items-start relative">
                            {stakeholder.logo ? (
                                <img src={stakeholder.logo} alt={stakeholder.name} class="w-24 h-24 md:w-28 md:h-28 flex-shrink-0 object-contain" />
                            ) : (
                                <div class="w-24 h-24 md:w-28 md:h-28 flex-shrink-0 rounded-full bg-white/10 flex items-center justify-center">
                                    <span class="text-white text-3xl md:text-4xl font-bold">{stakeholder.name.charAt(0)}</span>
                                </div>
                            )}

                            <div class="flex flex-col justify-center max-w-xs text-center md:text-left">
                                <h2 class="text-white font-bold text-xl md:text-2xl mb-1">{stakeholder.offerName}</h2>
                                <p class="text-white/70 text-base md:text-lg mb-3">{stakeholder.name}</p>
                                <a href={stakeholder.link} class="text-white/80 text-sm hover:text-white transition-colors font-medium">Mehr erfahren →</a>
                            </div>

                            {/* <!-- Line to Timeline -->
                            <span class="line_to_timeline hidden md:block absolute left-12 md:left-14 w-[2px] h-12 md:h-16 bg-white top-full"></span> */}
                        </div>
                    </div>

                    <!-- Next Ghost (Right) -->
                    {index < stakeholders.length - 1 && (
                        <div class="ghost-right absolute right-4 md:right-16 opacity-10 pointer-events-none">
                            <div class="stakeholder-group flex flex-col md:flex-row gap-2 md:gap-4 items-center md:items-start scale-75 md:scale-90">
                                {stakeholders[index + 1].logo ? (
                                    <img src={stakeholders[index + 1].logo} alt={stakeholders[index + 1].name} class="w-16 h-16 md:w-20 md:h-20 flex-shrink-0 object-contain" />
                                ) : (
                                    <div class="w-16 h-16 md:w-20 md:h-20 flex-shrink-0 rounded-full bg-white/10 flex items-center justify-center">
                                        <span class="text-white text-xl md:text-2xl font-bold">{stakeholders[index + 1].name.charAt(0)}</span>
                                    </div>
                                )}
                                <div class="flex flex-col justify-center max-w-xs text-center md:text-left">
                                    <h2 class="text-white font-bold text-sm md:text-lg">{stakeholders[index + 1].offerName}</h2>
                                    <p class="text-white/70 text-xs md:text-sm">{stakeholders[index + 1].name}</p>
                                </div>
                            </div>
                        </div>
                    )}
                </div>
            ))}
        </div>

        <!-- Interactive Progress Timeline -->
        <div class="progress-timeline-wrapper absolute bottom-16 md:bottom-20 left-1/2 -translate-x-1/2 w-[85%] md:w-[75%] z-10">
            <!-- Journey Phase Label -->
            <div class="journey-phase-label text-center mb-3">
                <span id="currentPhase" class="text-white text-xs md:text-sm font-semibold tracking-wide uppercase">
                    {stakeholders[0].journeyPhase}
                </span>
            </div>
            
            <!-- Progress Bar Container with Glass Effect -->
            <div class="progress-container relative bg-white/10 backdrop-blur-md rounded-full h-2 md:h-2.5 border border-white/20 shadow-lg">
                <!-- Filled Progress -->
                <div 
                    id="progressFill" 
                    class="progress-fill absolute top-0 left-0 h-full bg-gradient-to-r from-white/80 to-white rounded-full transition-all duration-500 ease-out"
                    style="width: 0%"
                ></div>
                
                <!-- Milestone Points -->
                <div class="milestone-points absolute inset-0 flex items-center justify-between px-1">
                    {stakeholders.map((_, index) => (
                        <button
                            class="milestone-point group relative z-10 border-0"
                            data-milestone-index={index}
                            aria-label={`Go to ${stakeholders[index].name}`}
                        >
                            <!-- Outer Ring (Active State) -->
                            <div class="milestone-ring absolute inset-0 -m-1.5 rounded-full border-2 border-white/0 transition-all duration-300 group-hover:border-white/40"></div>
                            
                            <!-- Dot -->
                            <div class="milestone-dot w-3 h-3 md:w-3.5 md:h-3.5 rounded-full bg-white/40 backdrop-blur-sm border-2 border-white/20 transition-all duration-300 group-hover:bg-white group-hover:scale-125 group-hover:shadow-lg"></div>
                            
                            <!-- Tooltip -->
                            <div class="milestone-tooltip absolute -top-10 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none">
                                <div class="bg-white/95 backdrop-blur-md text-gray-900 text-xs font-medium px-3 py-1.5 rounded-lg shadow-xl whitespace-nowrap">
                                    {stakeholders[index].name}
                                </div>
                                <div class="absolute top-full left-1/2 -translate-x-1/2 -mt-px">
                                    <div class="w-2 h-2 bg-white/95 rotate-45"></div>
                                </div>
                            </div>
                        </button>
                    ))}
                </div>
            </div>
        </div>

        <!-- Navigation Buttons - Apple Glass Style -->
        <button
            id="prevBtn"
            class="prev_step group absolute left-[7.5%] md:left-[12.5%] bottom-20 md:bottom-20 z-20 w-11 h-11 md:w-12 md:h-12 rounded-2xl bg-white/15 backdrop-blur-xl border border-white/20 text-white cursor-pointer flex items-center justify-center transition-all duration-200 hover:bg-white/25 active:scale-95 shadow-[0_8px_32px_0_rgba(0,0,0,0.12)]"
        >
            <svg class="w-5 h-5 transition-transform duration-200 group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>

        <button
            id="nextBtn"
            class="next_step group absolute right-[7.5%] md:right-[12.5%] bottom-20 md:bottom-20 z-20 w-11 h-11 md:w-12 md:h-12 rounded-2xl bg-white/15 backdrop-blur-xl border border-white/20 text-white cursor-pointer flex items-center justify-center transition-all duration-200 hover:bg-white/25 active:scale-95 shadow-[0_8px_32px_0_rgba(0,0,0,0.12)]"
        >
            <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
    </div>
</div>

<!-- Stakeholder Detail Section -->
<StakeholderDetail />

<style>
    .timeline-container {
        position: relative;
        overflow: hidden;
    }

    .liquid-background-wrapper {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
    }

    .background {
        background: transparent;
        position: relative;
        z-index: 1;
    }

    /* Hide scrollbar */
    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }

    /* Smooth scrolling */
    .stakeholder-scroll-container {
        scroll-behavior: smooth;
    }

    /* Stakeholder cards - cleaner design */
    .stakeholder-wrapper {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .stakeholder-group {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Ghost cards - more subtle */
    .ghost-left, .ghost-right {
        transition: opacity 0.3s ease;
    }

    /* Enhanced button styling */
    .prev_step, .next_step {
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    button:disabled {
        opacity: 0.2;
        cursor: not-allowed;
        pointer-events: none;
    }

    .prev_step:not(:disabled):hover,
    .next_step:not(:disabled):hover {
        background: rgba(255, 255, 255, 0.3);
        border-color: rgba(255, 255, 255, 0.4);
        transform: translateY(-50%) scale(1.05);
    }

    /* Progress timeline - more professional */
    .progress-timeline-wrapper {
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .progress-container {
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .progress-fill {
        background: linear-gradient(90deg,
            rgba(255, 255, 255, 0.9) 0%,
            rgba(255, 159, 252, 0.9) 100%
        );
        box-shadow: 0 0 20px rgba(255, 159, 252, 0.5);
    }

    /* Milestone points - cleaner design */
    .milestone-point {
        position: relative;
        background: transparent;
        border: none;
        padding: 0.5rem;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .milestone-dot {
        background: rgba(255, 255, 255, 0.3);
        border: 2px solid rgba(255, 255, 255, 0.5);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .milestone-point:hover .milestone-dot {
        background: rgba(255, 255, 255, 0.6);
        border-color: rgba(255, 255, 255, 0.8);
        transform: scale(1.2);
        box-shadow: 0 0 20px rgba(255, 255, 255, 0.4);
    }

    /* Active milestone styling */
    .milestone-point[data-active="true"] .milestone-dot {
        background: white;
        border-color: white;
        box-shadow: 0 0 25px rgba(255, 255, 255, 0.8),
                    0 0 50px rgba(255, 159, 252, 0.5);
        transform: scale(1.3);
    }

    .milestone-point[data-active="true"] .milestone-ring {
        border-color: rgba(255, 255, 255, 0.6);
    }

    /* Tooltip improvements */
    .milestone-tooltip {
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .milestone-point:hover .milestone-tooltip {
        transform: translate(-50%, -2px);
    }

    /* Journey phase label */
    #currentPhase {
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        letter-spacing: 0.08em;
    }

    /* Responsive improvements */
    @media (max-width: 768px) {
        .background {
            height: 35vh !important;
        }

        .progress-timeline-wrapper {
            width: 90%;
            bottom: 12px;
        }
    }
</style>

