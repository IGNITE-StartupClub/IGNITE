            offerDescription: "Erfahrene Unternehmer:innen und Investor:innen, die Startups mit Kapital und Know-how unterstützen. Neben der Seed-Finanzierung bieten Business Angels strategisches Mentoring, Netzwerkzugang und hands-on Unterstützung.",
            fullDescription: "Netzwerk erfahrener Unternehmer:innen und Investor:innen, die Startups mit Kapital und Know-how unterstützen. Business Angels investieren nicht nur Geld, sondern bringen auch ihre Expertise, Kontakte und Erfahrung ein, um dein Startup zum Erfolg zu führen.",
            contact: {
                website: "www.business-angels.de"
            },
            help: [
                "Seed-Finanzierung",
                "Strategisches Mentoring",
                "Netzwerkzugang & Türöffner",
                "Hands-on Unterstützung",
                "Kontakt über Gründungsservice"
            ]
        }
    ];

    // Function to scroll to a specific index
    function scrollToIndex(index: number) {
        if (index < 0 || index >= totalStakeholders) return;
        
        currentIndex = index;
        const scrollPosition = scrollContainer.clientWidth * index;
        scrollContainer.scrollTo({
            left: scrollPosition,
            behavior: 'smooth'
        });
        
        updateUI();
    }

    // Simple markdown parser for basic formatting
    function parseMarkdown(text: string): string {
        return text
            // Bold: **text** or __text__
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/__(.*?)__/g, '<strong>$1</strong>')
            // Italic: *text* or _text_
            .replace(/\*(.*?)\*/g, '<em>$1</em>')
            .replace(/_(.*?)_/g, '<em>$1</em>')
            // Links: [text](url)
            .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')
            // Line breaks
            .replace(/\n/g, '<br>');
    }

    // Update Stakeholder Detail Section
    function updateStakeholderDetails(index: number) {
        const stakeholder = stakeholders[index];

        // Update name (now shows offer name)
        const detailName = document.getElementById('detailName');
        if (detailName) detailName.textContent = stakeholder.offerName;

        // Update offer description
        const detailOfferDescription = document.getElementById('detailOfferDescription');
        if (detailOfferDescription) {
            detailOfferDescription.innerHTML = parseMarkdown(stakeholder.offerDescription);
        }

        // Update stakeholder description with markdown support
        const detailDescription = document.getElementById('detailDescription');
        if (detailDescription) {
            detailDescription.innerHTML = parseMarkdown(stakeholder.fullDescription);
        }

        // Update contact info with clickable links
        const detailContact = document.getElementById('detailContact');
        if (detailContact) {
            let contactHTML = '';
            if (stakeholder.contact.email) {
                contactHTML += `<div class="flex items-start gap-2">
                    <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    <a href="mailto:${stakeholder.contact.email}" class="hover:underline">${stakeholder.contact.email}</a>
                </div>`;
            }
            if (stakeholder.contact.phone) {
                contactHTML += `<div class="flex items-start gap-2">
                    <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                    <a href="tel:${stakeholder.contact.phone}" class="hover:underline">${stakeholder.contact.phone}</a>
                </div>`;
            }
            if (stakeholder.contact.website) {
                const url = stakeholder.contact.website.startsWith('http') ? stakeholder.contact.website : `https://${stakeholder.contact.website}`;
                contactHTML += `<div class="flex items-start gap-2">
                    <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                    </svg>
                    <a href="${url}" target="_blank" rel="noopener noreferrer" class="hover:underline">${stakeholder.contact.website}</a>
                </div>`;
            }
            if (stakeholder.contact.address) {
                contactHTML += `<div class="flex items-start gap-2">
                    <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span>${stakeholder.contact.address}</span>
                </div>`;
            }
            detailContact.innerHTML = contactHTML;
        }

        // Update contact button
        const contactButton = document.getElementById('contactButton') as HTMLAnchorElement;
        if (contactButton && stakeholder.contact.email) {
            contactButton.href = `mailto:${stakeholder.contact.email}?subject=Anfrage über IGNITE Stakeholder Journey Map`;
            contactButton.style.display = 'flex';
        } else if (contactButton) {
            contactButton.style.display = 'none';
        }

        // Update help section
        const detailHelp = document.getElementById('detailHelp');
        if (detailHelp) {
            let helpHTML = '<ul>';
            stakeholder.help.forEach(item => {
                helpHTML += `<li class="flex items-start gap-2">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>${item}</span>
                </li>`;
            });
            helpHTML += '</ul>';
            detailHelp.innerHTML = helpHTML;
        }
    }

    // Update UI elements
    function updateUI() {
        // Calculate progress percentage
        const progressPercentage = (currentIndex / (totalStakeholders - 1)) * 100;
        progressFill.style.width = `${progressPercentage}%`;

        // Update milestone points
        milestonePoints.forEach((point, index) => {
            if (index === currentIndex) {
                point.setAttribute('data-active', 'true');
            } else {
                point.setAttribute('data-active', 'false');
            }
        });

        // Update journey phase label
        currentPhaseLabel.textContent = stakeholders[currentIndex].journeyPhase;

        // Update button states
        prevBtn.disabled = currentIndex === 0;
        nextBtn.disabled = currentIndex === totalStakeholders - 1;

        // Update stakeholder details
        updateStakeholderDetails(currentIndex);
    }

    // Button click handlers
    prevBtn.addEventListener('click', () => {
        if (currentIndex > 0) scrollToIndex(currentIndex - 1);
    });

    nextBtn.addEventListener('click', () => {
        if (currentIndex < totalStakeholders - 1) scrollToIndex(currentIndex + 1);
    });

    // Milestone point click handlers
    milestonePoints.forEach((point, index) => {
        point.addEventListener('click', () => {
            scrollToIndex(index);
        });
    });

    // Handle scroll events
    let scrollTimeout: number;
    scrollContainer.addEventListener('scroll', () => {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
            const scrollLeft = scrollContainer.scrollLeft;
            const slideWidth = scrollContainer.clientWidth;
            const newIndex = Math.round(scrollLeft / slideWidth);
            
            if (newIndex !== currentIndex) {
                currentIndex = newIndex;
                updateUI();
            }
        }, 100);
    });

    // Initialize
    updateUI();

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft' && currentIndex > 0) {
            scrollToIndex(currentIndex - 1);
        } else if (e.key === 'ArrowRight' && currentIndex < totalStakeholders - 1) {
            scrollToIndex(currentIndex + 1);
        }
    });
</script>