{
  "collectionName": "components_questionnaire_questions",
  "info": {
    "displayName": "Questionnaire Question",
    "description": "A single question in the questionnaire"
  },
  "options": {},
  "attributes": {
    "questionId": {
      "type": "string",
      "required": true
    },
    "step": {
      "type": "enumeration",
      "enum": ["3", "4", "5"],
      "required": true
    },
    "label": {
      "type": "text",
      "required": true
    },
    "fieldType": {
      "type": "enumeration",
      "enum": ["textarea", "text", "email"],
      "default": "textarea",
      "required": true
    },
    "rows": {
      "type": "integer",
      "default": 4
    },
    "placeholder": {
      "type": "string"
    },
    "required": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
