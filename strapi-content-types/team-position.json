{
  "kind": "collectionType",
  "collectionName": "team_positions",
  "info": {
    "singularName": "team-position",
    "pluralName": "team-positions",
    "displayName": "Team Position",
    "description": "Offene Team-Positionen bei IGNITE"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "team": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": ["intern", "extern"],
      "default": "extern"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
