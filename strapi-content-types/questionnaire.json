{
  "kind": "singleType",
  "collectionName": "questionnaire",
  "info": {
    "singularName": "questionnaire",
    "pluralName": "questionnaires",
    "displayName": "Questionnaire",
    "description": "Configuration for the application questionnaire"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "step1ButtonText": {
      "type": "string",
      "default": "Bewerbung ausfüllen",
      "required": true
    },
    "step2Label": {
      "type": "string",
      "default": "Wähle 2-3 Teams, in denen du mitarbeiten möchtest:",
      "required": true
    },
    "step2MinTeams": {
      "type": "integer",
      "default": 2,
      "required": true
    },
    "step2MaxTeams": {
      "type": "integer",
      "default": 3,
      "required": true
    },
    "step2HintTooFew": {
      "type": "string",
      "default": "Bitte wähle mindestens 2 Teams aus.",
      "required": true
    },
    "step2HintMaximum": {
      "type": "string",
      "default": "Du hast die maximale Anzahl von 3 Teams ausgewählt.",
      "required": true
    },
    "step3QuestionLabel": {
      "type": "string",
      "default": "Was beschreibt deine Situation am besten?",
      "required": true
    },
    "step3Options": {
      "type": "component",
      "repeatable": true,
      "component": "startup-interest-option"
    },
    "questions": {
      "type": "component",
      "repeatable": true,
      "component": "questionnaire-question"
    },
    "step6FirstNameLabel": {
      "type": "string",
      "default": "Vorname",
      "required": true
    },
    "step6LastNameLabel": {
      "type": "string",
      "default": "Nachname",
      "required": true
    },
    "step6EmailLabel": {
      "type": "string",
      "default": "E-Mail",
      "required": true
    }
  }
}
