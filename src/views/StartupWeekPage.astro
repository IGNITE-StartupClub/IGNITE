---
/**
 * "Deine Startup-Woche": the link in the Instagram bio. Lists the startup events of one week in Lüneburg and Hamburg,
 * each with a direct registration link, so the weekly post no longer needs links in its caption.
 * The data is one JSON file per week in src/content/startupWeek/ (schema in content.config.mjs); which week shows
 * is decided per request by `currentEdition` (src/lib/startupWeek.ts), so the next week appears on Sunday without
 * a deploy. Events of the shown week that are over stay in the list, dimmed and without the register button.
 */
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import Section from '../components/ui/Section.astro'
import Button from '../components/ui/Button.astro'
import { getCopy } from '../data/copy'
import { dateLocales, localizePath, resolveLocale } from '../lib/i18n'
import { addDays, berlinDay, currentEdition, isPast, sortEvents } from '../lib/startupWeek'

const locale = resolveLocale(Astro.currentLocale)
const { startupWeekPage: copy, pageMeta } = getCopy(locale)
const instagramMessageUrl = 'https://ig.me/m/ignite.lueneburg'

const today = berlinDay(new Date())
const editions = (await getCollection('startupWeek')).map((entry) => entry.data)
const edition = currentEdition(editions, today)
const events = edition ? sortEvents(edition.events) : []

// Days are calendar dates without a time zone, so they are formatted in UTC to stay on the same day.
const asDate = (day: string) => new Date(`${day}T12:00:00Z`)
const format = (day: string, options: Intl.DateTimeFormatOptions) => asDate(day).toLocaleDateString(dateLocales[locale], { timeZone: 'UTC', ...options })
const weekRange = edition
  ? new Intl.DateTimeFormat(dateLocales[locale], { timeZone: 'UTC', day: 'numeric', month: 'long' }).formatRange(asDate(edition.start), asDate(addDays(edition.start, 6)))
  : ''
const weekday = (day: string) => format(day, { weekday: 'short' }).replace('.', '')
const shortDate = (day: string) => (locale === 'de' ? format(day, { day: '2-digit', month: '2-digit' }) : format(day, { day: 'numeric', month: 'short' }))
const clock = (time: string) => (locale === 'de' ? `${time} Uhr` : time)
---

<DefaultLayout title={pageMeta.startupWeek.title} description={pageMeta.startupWeek.description} url={localizePath('/startup-woche', locale)}>
  <PageHeader title={copy.title} lead={copy.lead} compact>
    {edition && <p class="week-range">{weekRange}</p>}
  </PageHeader>

  <Section spacing="xs" width="article">
    {
      events.length === 0 ? (
        <div class="week-empty">
          <p>{copy.empty}</p>
          <Button href="https://www.instagram.com/ignite.lueneburg/" variant="outline" icon="ion:logo-instagram" target="_blank" rel="noopener">
            @ignite.lueneburg
          </Button>
        </div>
      ) : (
        <ol class="week-list">
          {events.map((event) => {
            const text = event[locale]
            const past = isPast(event, today)
            return (
              <li class:list={['week-event', { 'week-event--past': past }]}>
                <time class="week-day" datetime={event.time ? `${event.date}T${event.time}` : event.date}>
                  <span class="week-weekday">{weekday(event.date)}</span>
                  <span class="week-date">{shortDate(event.date)}</span>
                </time>
                <div class="week-body">
                  <p class="week-host">{event.host}</p>
                  <h2 class="week-title">
                    {event.emoji && <span class="week-emoji" aria-hidden="true">{event.emoji}</span>}
                    {text.title}
                  </h2>
                  <p class="week-facts">
                    {[event.time && clock(event.time), text.place, text.note].filter(Boolean).join(' · ')}
                  </p>
                  <p class="week-text">{text.text}</p>
                  {past ? (
                    <span class="week-past">{copy.past}</span>
                  ) : (
                    <Button href={event.url} target="_blank" rel="noopener" size="sm" icon="ion:arrow-forward">{copy.register}</Button>
                  )}
                </div>
              </li>
            )
          })}
        </ol>
      )
    }
  </Section>

  <Section spacing="sm" width="article" labelledby="together-heading">
    <div class="week-together">
      <h2 id="together-heading" class="text-display-sm">{copy.together.heading}</h2>
      <p>{copy.together.text}</p>
      <div class="week-actions">
        <Button href={instagramMessageUrl} variant="secondary" icon="ion:logo-instagram" target="_blank" rel="noopener">{copy.together.message}</Button>
        <Button href={localizePath('/subscribe', locale)} variant="outline" icon="ion:logo-whatsapp">{copy.together.community}</Button>
      </div>
    </div>
    <p class="week-disclaimer">{copy.disclaimer}</p>
  </Section>
</DefaultLayout>

<style>
  .week-range { margin-top: 1rem; color: var(--color-accent-text); font-size: var(--text-sm); font-weight: 650; letter-spacing: .12em; text-transform: uppercase; }

  .week-list { display: grid; }
  .week-event { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: 1.5rem; padding: 1.75rem 0; border-top: 1px solid var(--color-border); }
  .week-event:last-child { border-bottom: 1px solid var(--color-border); }
  .week-day { display: flex; flex-direction: column; padding-top: 1.6rem; line-height: 1.2; }
  .week-weekday { color: var(--color-accent-text); font-weight: 650; }
  .week-date { color: var(--color-fg-muted); }

  .week-body { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .week-host { color: var(--color-accent-text); font-size: var(--text-xs); font-weight: 650; letter-spacing: .1em; text-transform: uppercase; }
  .week-title { margin-top: .35rem; font-size: 1.35rem; font-weight: 650; line-height: 1.25; letter-spacing: -.02em; }
  .week-emoji { margin-right: .4rem; }
  .week-facts { margin-top: .4rem; color: var(--color-fg-muted); font-size: var(--text-sm); }
  .week-text { margin: .75rem 0 1.25rem; max-width: 40rem; font-size: var(--text-sm); }
  .week-past { padding: .45rem 1rem; color: var(--color-fg-muted); font-size: var(--text-sm); font-weight: 650; border: 1px solid var(--color-border); border-radius: 999px; }
  .week-event--past .week-day, .week-event--past .week-host, .week-event--past .week-title, .week-event--past .week-facts, .week-event--past .week-text { opacity: .55; }

  .week-empty { display: grid; justify-items: start; gap: 1.25rem; padding: 2rem; color: var(--color-fg-muted); border: 1px dashed var(--color-border); border-radius: var(--radius-card); }

  .week-together { display: grid; gap: 1rem; padding: 2rem; border-radius: var(--radius-card); background: var(--color-card); border: 1px solid var(--color-border); }
  .week-together p { max-width: 40rem; color: var(--color-fg-muted); }
  .week-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: .5rem; }
  .week-disclaimer { margin-top: 1.5rem; color: var(--color-fg-muted); font-size: var(--text-xs); }

  @media (max-width: 639px) {
    .week-event { grid-template-columns: 1fr; gap: .75rem; padding: 1.5rem 0; }
    .week-day { flex-direction: row; gap: .4rem; padding-top: 0; }
    .week-together { padding: 1.5rem; }
  }
</style>
