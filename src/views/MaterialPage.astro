---
/**
 * Material detail page from the `materials` content collection, rendered by pages/materialien/[material].astro
 * and pages/en/materials/[material].astro, and inside the members area by pages/mitglieder/guide/[...path].astro
 * (+ English). Props: material (collection entry); members area only: basePath (guide root for the crumbs and the
 * back link), homeHref and homeLabel (first crumb), alternatePath (the other language's page, also marks it noindex).
 */
import { render, type CollectionEntry } from 'astro:content'
import DefaultLayout from '../layouts/DefaultLayout.astro'
import ArticleView from '../components/ui/ArticleView.astro'
import { getMaterialCover } from '../data/editorialAssets'
import { getCopy } from '../data/copy'
import { formatDate, resolveLocale } from '../lib/i18n'

interface Props {
  material: CollectionEntry<'materials'>
  basePath?: string
  homeHref?: string
  homeLabel?: string
  alternatePath?: string
}

const locale = resolveLocale(Astro.currentLocale)
const { listingPages, commonUi, navigation } = getCopy(locale)
const copy = listingPages.materials
const {
  material,
  basePath = copy.path,
  homeHref = navigation.homeUrl,
  homeLabel = commonUi.homeCrumb,
  alternatePath,
} = Astro.props
const { Content } = await render(material)
---

<DefaultLayout
  title={material.data.title}
  description={material.data.description}
  url={alternatePath ? undefined : 'materialien/' + material.id}
  alternatePath={alternatePath}
  noindex={!!alternatePath}
>
  <ArticleView
    title={material.data.title}
    date={formatDate(material.data.date, locale)}
    meta={[material.data.tag, material.data.author ?? '']}
    image={getMaterialCover(material.id, material.data.image)}
    crumbs={[{ label: homeLabel, href: homeHref }, { label: copy.crumb, href: basePath }, { label: material.data.title }]}
    backHref={basePath}
    backLabel={copy.backLabel}
  >
    <Content />
  </ArticleView>
</DefaultLayout>
