---
/**
 * Set a members area password, rendered on demand by pages/mitglieder/passwort.astro and
 * pages/en/members/password.astro. Reachable without a session (memberAuth.ts PUBLIC_PAGES).
 * With ?token, the target of the invitation and reset mails, it shows SetPasswordForm; opening the page does not use
 * up the link, only saving does. Without a token it offers to request a new link (MemberLoginForm in link mode),
 * which is also how signed-in members change their password.
 * Data source: memberArea via getCopy().
 */
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import Section from '../components/ui/Section.astro'
import MemberLoginForm from '../components/forms/MemberLoginForm.jsx'
import SetPasswordForm from '../components/forms/SetPasswordForm.jsx'
import { getCopy } from '../data/copy'
import { resolveLocale } from '../lib/i18n'
import { memberPagePath } from '../lib/memberAuth'

const locale = resolveLocale(Astro.currentLocale)
const { memberArea } = getCopy(locale)
const { password } = memberArea
const token = Astro.url.searchParams.get('token')
const requestUrl = memberPagePath('password', locale)
// The URL can carry a token: keep it out of caches and out of the Referer of outgoing requests.
Astro.response.headers.set('Cache-Control', 'private, no-store')
Astro.response.headers.set('Referrer-Policy', 'no-referrer')
---

<DefaultLayout title={password.pageTitle} alternatePath={memberPagePath('password', locale === 'de' ? 'en' : 'de')} noindex>
  {
    token ? (
      <>
        <PageHeader title={password.title} lead={password.lead} />
        <Section tone="subtle" width="text" spacing="sm" labelledby="page-title">
          <SetPasswordForm client:load copy={password.form} token={token} locale={locale} requestUrl={requestUrl} />
        </Section>
      </>
    ) : (
      <>
        <PageHeader title={password.requestTitle} lead={password.requestLead} />
        <Section tone="subtle" width="text" spacing="sm" labelledby="page-title">
          <MemberLoginForm client:load copy={memberArea.form} linkCopy={memberArea.linkForm} locale={locale} initialMode="link" />
        </Section>
      </>
    )
  }
</DefaultLayout>
