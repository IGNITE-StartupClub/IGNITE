---
/**
 * Email signature generator for members, rendered on demand by pages/mitglieder/signatur.astro and
 * pages/en/members/signature.astro. Guarded by src/middleware.ts like every members area page.
 * The generator itself is the SignatureGenerator island. The server keeps the member's photo and, for admins, the
 * signature they copied last, which closes the invitations they send.
 * Data source: memberArea, footer.socialLinks via getCopy(), the member's photo and saved signature via members.ts.
 */
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import Section from '../components/ui/Section.astro'
import SignatureGenerator from '../components/forms/SignatureGenerator.jsx'
import { getCopy } from '../data/copy'
import { resolveLocale } from '../lib/i18n'
import { photoPath } from '../lib/emailSignature'
import { memberHomePath, memberPagePath } from '../lib/memberAuth'
import { findMember, photoIdOf } from '../lib/members'

const locale = resolveLocale(Astro.currentLocale)
const { memberArea, footer } = getCopy(locale)
const { signature } = memberArea
const links = footer.socialLinks
  .filter(({ platform }) => ['Instagram', 'LinkedIn'].includes(platform))
  .map(({ platform, url }) => ({ platform, url }))
// The English route has its own slug, which switchLocalePath cannot derive from the German one.
const alternatePath = memberPagePath('signature', locale === 'de' ? 'en' : 'de')
const member = Astro.locals.member!
const [photoId, saved] = await Promise.all([photoIdOf(member.email), findMember(member.email)])
const isAdmin = member.role === 'admin'
---

<DefaultLayout title={signature.pageTitle} alternatePath={alternatePath} noindex>
  <PageHeader title={signature.title} lead={signature.lead}>
    <p class="form-note"><a href={memberHomePath(locale)}>{signature.back}</a></p>
  </PageHeader>
  <Section tone="subtle" spacing="sm" labelledby="page-title">
    <SignatureGenerator
      client:load
      copy={signature.generator}
      links={links}
      defaultEmail={member.email}
      photo={photoId ? photoPath(photoId) : ''}
      saved={isAdmin ? (saved?.signature ?? null) : null}
      savesSignature={isAdmin}
    />
  </Section>
  <Section spacing="sm" labelledby="signature-steps">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-8">
      <div>
        <h2 id="signature-steps" class="text-display-sm">{signature.stepsHeading}</h2>
        <p class="mt-3 text-fg-muted">{signature.stepsLead}</p>
      </div>
      <ol class="grid gap-3">
        {
          signature.steps.map((step, index) => (
            <li class="flex gap-4 rounded-card border border-border bg-bg p-4 sm:p-5">
              <span
                aria-hidden="true"
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-bright text-sm font-semibold text-white"
              >
                {index + 1}
              </span>
              <p class="pt-1 text-fg-muted" set:html={step} />
            </li>
          ))
        }
      </ol>
    </div>
  </Section>
</DefaultLayout>
