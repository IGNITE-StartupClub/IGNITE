---
/**
 * Email signature generator for members, rendered on demand by pages/mitglieder/signatur.astro and
 * pages/en/members/signature.astro. Guarded by src/middleware.ts like every members area page.
 * The generator itself is the SignatureGenerator island; nothing is stored on the server.
 * Data source: memberArea, footer.socialLinks via getCopy().
 */
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import Section from '../components/ui/Section.astro'
import SignatureGenerator from '../components/forms/SignatureGenerator.jsx'
import { getCopy } from '../data/copy'
import { resolveLocale } from '../lib/i18n'
import { memberHomePath, memberSignaturePath } from '../lib/memberAuth'

const locale = resolveLocale(Astro.currentLocale)
const { memberArea, footer } = getCopy(locale)
const { signature } = memberArea
const links = footer.socialLinks
  .filter(({ platform }) => ['Instagram', 'LinkedIn'].includes(platform))
  .map(({ platform, url }) => ({ platform, url }))
// The English route has its own slug, which switchLocalePath cannot derive from the German one.
const alternatePath = memberSignaturePath(locale === 'de' ? 'en' : 'de')
---

<DefaultLayout title={signature.pageTitle} alternatePath={alternatePath} noindex>
  <PageHeader title={signature.title} lead={signature.lead}>
    <p class="form-note"><a href={memberHomePath(locale)}>{signature.back}</a></p>
  </PageHeader>
  <Section tone="subtle" width="article" spacing="sm" labelledby="page-title">
    <SignatureGenerator client:load copy={signature.generator} links={links} defaultEmail={Astro.locals.member!.email} />
  </Section>
  <Section width="article" spacing="sm" labelledby="signature-steps">
    <h2 id="signature-steps" class="text-display-sm mb-6">{signature.stepsHeading}</h2>
    <ol class="list-decimal space-y-3 pl-5 text-fg-muted">
      {signature.steps.map((step) => <li set:html={step} />)}
    </ol>
  </Section>
</DefaultLayout>
