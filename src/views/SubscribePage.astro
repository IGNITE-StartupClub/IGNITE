---
/**
 * Community page: team portraits, the entry point to the members area, then the email form that mails the WhatsApp
 * invite link. The footer leaves out its own form here.
 * Rendered by pages/subscribe.astro and pages/en/subscribe.astro. Data source: subscribePage, communityForm, memberArea, pageMeta via getCopy().
 */
import DefaultLayout from '../layouts/DefaultLayout.astro'
import TeamPortraits from '../components/sections/TeamPortraits.astro'
import Section from '../components/ui/Section.astro'
import Button from '../components/ui/Button.astro'
import CommunityForm from '../components/forms/CommunityForm.jsx'
import { getCopy } from '../data/copy'
import { resolveLocale } from '../lib/i18n'
import { memberHomePath } from '../lib/memberAuth'

const locale = resolveLocale(Astro.currentLocale)
const { subscribePage, communityForm, memberArea, pageMeta } = getCopy(locale)
---

<DefaultLayout title={pageMeta.community.title} footerSignup={false}>
  <TeamPortraits />
  <Section spacing="sm" labelledby="members-heading">
    <div class="flex flex-col items-start gap-6 border-t border-border pt-10 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 id="members-heading" class="text-xl font-semibold" set:html={memberArea.teaser.heading} />
        <p class="mt-2 text-balance text-fg-muted">{memberArea.teaser.lead}</p>
      </div>
      <Button href={memberHomePath(locale)} variant="outline" icon="ion:lock-closed-outline" class="shrink-0" data-member-entry>{memberArea.teaser.link}</Button>
    </div>
  </Section>
  <Section tone="subtle" spacing="sm" labelledby="newsletter-heading">
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 id="newsletter-heading" class="text-display-sm" set:html={subscribePage.title} />
        <p class="mt-3 max-w-text text-fg-muted">{subscribePage.lead}</p>
      </div>
      <CommunityForm client:visible compact copy={{ ...communityForm, submit: subscribePage.submit }} />
    </div>
  </Section>
</DefaultLayout>
