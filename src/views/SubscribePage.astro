---
/**
 * Newsletter page: subscribe form, plus double opt-in confirmation (?token=) and unsubscribe (?cancel=).
 * Rendered by pages/subscribe.astro and pages/en/subscribe.astro. Data source: subscribePage, subscribeForm, pageMeta via getCopy().
 */
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import Section from '../components/ui/Section.astro'
import SubscribeForm from '../components/forms/SubscribeForm.jsx'
import { getCopy } from '../data/copy'

const { subscribePage, subscribeForm, pageMeta } = getCopy(Astro.currentLocale)
---

<DefaultLayout title={pageMeta.newsletter.title}>
  <PageHeader title={subscribePage.title} lead={subscribePage.lead} />
  <Section tone="subtle" width="text" spacing="sm" labelledby="page-title">
    <SubscribeForm client:load copy={subscribeForm} />
  </Section>
</DefaultLayout>
