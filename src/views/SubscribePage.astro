---
/**
 * Community page: email form that mails the WhatsApp invite link.
 * Rendered by pages/subscribe.astro and pages/en/subscribe.astro. Data source: subscribePage, communityForm, pageMeta via getCopy().
 */
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import Section from '../components/ui/Section.astro'
import CommunityForm from '../components/forms/CommunityForm.jsx'
import { getCopy } from '../data/copy'

const { subscribePage, communityForm, pageMeta } = getCopy(Astro.currentLocale)
---

<DefaultLayout title={pageMeta.community.title}>
  <PageHeader title={subscribePage.title} lead={subscribePage.lead} />
  <Section tone="subtle" width="text" spacing="sm" labelledby="page-title">
    <CommunityForm client:load compact copy={{ ...communityForm, submit: subscribePage.submit }} />
  </Section>
</DefaultLayout>
