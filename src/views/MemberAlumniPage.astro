---
/**
 * The alumni tab of the Netzwerk section, rendered on demand by pages/mitglieder/netzwerk/alumni.astro and
 * pages/en/members/network/alumni.astro. Every signed-in member sees it (src/middleware.ts). The profiles are rendered
 * from the database and handed to the AlumniDirectory island, which talks to /api/members/alumni.
 * Data source: memberArea.alumni via getCopy(), profiles via alumniState().
 */
import MemberNetworkLayout from '../layouts/MemberNetworkLayout.astro'
import AlumniDirectory from '../components/forms/AlumniDirectory.jsx'
import { getCopy } from '../data/copy'
import { alumniState } from '../lib/contactsStore'
import { resolveLocale } from '../lib/i18n'

const { alumni } = getCopy(resolveLocale(Astro.currentLocale)).memberArea
const { revision, alumni: profiles } = await alumniState(Astro.locals.member!)
---

<MemberNetworkLayout tab="alumni">
  <AlumniDirectory client:load copy={alumni.directory} initialAlumni={profiles} initialRevision={revision} />
</MemberNetworkLayout>
