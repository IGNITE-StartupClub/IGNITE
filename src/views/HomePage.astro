---
/**
 * Home page, rendered by pages/index.astro (German) and pages/en/index.astro (English).
 * Data source: pageMeta.home via getCopy(); section copy is resolved inside the sections.
 */
import DefaultLayout from '../layouts/DefaultLayout.astro'
import Hero from '../components/sections/Hero.astro'
import Why from '../components/sections/Why.astro'
import Expect from '../components/sections/Expect.astro'
import People from '../components/sections/People.astro'
import LatestNews from '../components/sections/LatestNews.astro'
import Faq from '../components/sections/Faq.astro'
import FinalCta from '../components/sections/FinalCta.astro'
import { getCopy } from '../data/copy'
import { organizationJsonLd } from '../lib/seo'

const { pageMeta, globalConfig, siteMeta, footer } = getCopy(Astro.currentLocale)
// Google reads the organization from the home page; the other pages do not repeat it.
const organization = organizationJsonLd({
  name: globalConfig.siteName,
  url: new URL('/', Astro.site).href,
  logo: new URL('/favicon-512.png', Astro.site).href,
  description: siteMeta.description,
  email: globalConfig.contactEmail,
  sameAs: footer.socialLinks.map((link) => link.url),
})
---

<DefaultLayout title={pageMeta.home.title} description={pageMeta.home.description} jsonLd={[organization]}>
  <Hero />
  <Expect />
  <Why />
  <People />
  <LatestNews />
  <Faq />
  <FinalCta />
</DefaultLayout>
