---
/**
 * Members area sign-in, rendered on demand by pages/mitglieder/login.astro and pages/en/members/login.astro.
 * Email and password form (MemberLoginForm island), which also requests a link to set a password.
 * Data source: memberArea via getCopy().
 */
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import Section from '../components/ui/Section.astro'
import MemberLoginForm from '../components/forms/MemberLoginForm.jsx'
import { getCopy } from '../data/copy'
import { resolveLocale } from '../lib/i18n'

const locale = resolveLocale(Astro.currentLocale)
const { memberArea } = getCopy(locale)
Astro.response.headers.set('Cache-Control', 'private, no-store')
---

<DefaultLayout title={memberArea.pageTitle} noindex>
  <PageHeader title={memberArea.login.title} lead={memberArea.login.lead} />
  <Section tone="subtle" width="text" spacing="sm" labelledby="page-title">
    <MemberLoginForm client:load copy={memberArea.form} linkCopy={memberArea.linkForm} locale={locale} />
  </Section>
</DefaultLayout>
