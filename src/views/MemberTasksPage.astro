---
/**
 * The tasks module of the members area, rendered on demand by pages/mitglieder/aufgaben.astro and
 * pages/en/members/tasks.astro. Loads the events of the public calendar (taskEvents.ts), refreshes the event snapshots
 * of planning projects and hands everything to the TaskWorkspace island, which talks to /api/members/tasks and renders
 * the page's heading itself, because it changes with the view.
 * Data source: memberArea.tasks, memberArea.search and openTeams via getCopy(), projects and members via workspaceState().
 */
import DefaultLayout from '../layouts/DefaultLayout.astro'
import Section from '../components/ui/Section.astro'
import TaskWorkspace from '../components/forms/TaskWorkspace.jsx'
import { getCopy } from '../data/copy'
import { teamNames } from '../data/openTeams'
import { resolveLocale } from '../lib/i18n'
import { memberPagePath } from '../lib/memberAuth'
import { berlinClock, berlinDay } from '../lib/tasks'
import { loadTaskEvents } from '../lib/taskEvents'
import { sessionActor, syncEvents, workspaceState } from '../lib/tasksStore'

const locale = resolveLocale(Astro.currentLocale)
const { memberArea, openTeams } = getCopy(locale)
const { tasks } = memberArea
const actor = sessionActor(Astro.locals.member!)

// The projects do not wait for the calendar: a refreshed event snapshot shows with the next load. Snapshots are stored
// once for both languages, in German like the link in the tasks API, otherwise every English load rewrote the place.
const [{ events, complete }, state] = await Promise.all([
  loadTaskEvents(locale),
  workspaceState(actor),
  loadTaskEvents('de').then((german) => syncEvents(german.events, german.complete)),
])
const calendar = events.map(({ startAt, endAt, ...event }) => ({
  ...event,
  day: berlinDay(startAt.getTime()),
  endDay: berlinDay(endAt.getTime()),
  time: berlinClock(startAt.getTime()),
}))
const now = Date.now()
---

<DefaultLayout title={tasks.pageTitle} alternatePath={memberPagePath('tasks', locale === 'de' ? 'en' : 'de')} noindex>
  <Section spacing="xs" labelledby="page-title">
    <TaskWorkspace
      client:load
      copy={{ ...tasks.workspace, teams: teamNames(openTeams), problems: memberArea.search.task.problems }}
      initialState={state}
      events={calendar}
      eventsComplete={complete}
      me={actor.id}
      named={actor.named}
      admin={actor.role === 'admin'}
      board={Astro.locals.member!.position === 'board'}
      locale={locale}
      today={berlinDay(now)}
    />
  </Section>
</DefaultLayout>
