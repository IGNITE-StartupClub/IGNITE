---
/**
 * The benefits of the members area, rendered on demand by pages/mitglieder/vorteile.astro and
 * pages/en/members/benefits.astro. One card per offer from memberArea.benefits.items; a new offer is a new entry
 * there (German and English), the page needs no change.
 * Data source: memberArea.benefits via getCopy().
 */
import { Icon } from 'astro-icon/components'
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import Section from '../components/ui/Section.astro'
import Card from '../components/ui/Card.astro'
import { getCopy } from '../data/copy'
import { resolveLocale } from '../lib/i18n'
import { memberHomePath, memberPagePath } from '../lib/memberAuth'

const locale = resolveLocale(Astro.currentLocale)
const { benefits, nav } = getCopy(locale).memberArea
---

<DefaultLayout
  title={benefits.pageTitle}
  alternatePath={memberPagePath('benefits', locale === 'de' ? 'en' : 'de')}
  noindex
>
  <PageHeader compact title={benefits.title} lead={benefits.lead}>
    <p class="form-note"><a href={memberHomePath(locale)}>{benefits.back}</a></p>
  </PageHeader>
  <Section tone="subtle" spacing="xs" labelledby="page-title">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        benefits.items.map((item) => (
          <Card as="li" class="h-full">
            <Icon slot="icon" name={item.icon} aria-hidden="true" />
            <h2 slot="title" class="text-xl">
              {/* The link stretches over the whole card, so the card is one click target. */}
              <a
                href={item.url}
                class="after:absolute after:inset-0 after:content-['']"
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.title}
                <span class="sr-only"> ({nav.newTab})</span>
              </a>
            </h2>
            <p class="text-fg-muted">{item.text}</p>
          </Card>
        ))
      }
    </ul>
  </Section>
</DefaultLayout>
