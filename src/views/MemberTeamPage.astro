---
/**
 * The team tab of the Netzwerk section, rendered on demand by pages/mitglieder/netzwerk/team.astro and
 * pages/en/members/network/team.astro. Shows the same team descriptions as the join page (OpenTeamsGrid); team photos
 * are meant to be added here later.
 * Data source: openTeams via getCopy().
 */
import MemberNetworkLayout from '../layouts/MemberNetworkLayout.astro'
import OpenTeamsGrid from '../components/mitmachen/OpenTeamsGrid.astro'
import { getCopy } from '../data/copy'
import { resolveLocale } from '../lib/i18n'

const { openTeams } = getCopy(resolveLocale(Astro.currentLocale))
---

<MemberNetworkLayout tab="team">
  <OpenTeamsGrid teams={openTeams} />
</MemberNetworkLayout>
