---
/**
 * Upcoming events, loaded live from the IGNITE Luma calendar (src/lib/luma.ts) and merged with the hand-listed
 * events of src/data/externalEvents.ts.
 * Rendered per request and cached at the edge by pages/events.astro and pages/en/events.astro, so new Luma events
 * appear without a deploy. Props: events and pastEvents (each null if Luma could not be reached).
 * Past events follow in their own section, newest first, as plain cards without a register button.
 * The next event is shown large, later ones in a grid. The whole card links to the event page. The register button
 * opens the Luma event page in a new tab; external events link to their own registration page instead.
 * Dates and times follow the page language (24-hour clock with "Uhr" in German, 12-hour clock in English).
 * Events spanning several days show the date range instead of the times.
 */
import { Icon } from 'astro-icon/components'
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import Section from '../components/ui/Section.astro'
import Button from '../components/ui/Button.astro'
import { lumaCalendarUrl, type LumaEvent } from '../lib/luma'
import type { ExternalEvent } from '../data/externalEvents'
import { dateLocales, resolveLocale } from '../lib/i18n'
import { getCopy } from '../data/copy'

interface Props {
  events: LumaEvent[] | null
  pastEvents: LumaEvent[] | null
}

type ListedEvent = LumaEvent | ExternalEvent

const { events, pastEvents } = Astro.props
const locale = resolveLocale(Astro.currentLocale)
const { eventsPage: copy, pageMeta, externalEvents } = getCopy(locale)

const now = new Date()
const byStart = (a: ListedEvent, b: ListedEvent) => a.startAt.getTime() - b.startAt.getTime()
const listed: ListedEvent[] = [...(events ?? []), ...externalEvents.filter((event) => event.endAt > now)].sort(byStart)
const past: ListedEvent[] = [...(pastEvents ?? []), ...externalEvents.filter((event) => event.endAt <= now)].sort((a, b) => byStart(b, a))

// Upcoming events always get a section (with the empty or unavailable note); past events only when there are any.
const groups = [
  { headingId: 'events-heading', heading: copy.heading, events: listed, past: false },
  ...(past.length > 0 ? [{ headingId: 'past-events-heading', heading: copy.pastHeading, events: past, past: true }] : []),
]

// The next event is large. With only two events both are, so the second does not sit alone in a three-column row.
const isFeatured = (index: number) => index === 0 || listed.length <= 2

const format = (event: ListedEvent, options: Intl.DateTimeFormatOptions, date = event.startAt) =>
  date.toLocaleString(dateLocales[locale], { timeZone: event.timezone, ...options })
const isMultiDay = (event: ListedEvent) => format(event, { dateStyle: 'short' }) !== format(event, { dateStyle: 'short' }, event.endAt)
const formatWhen = (event: ListedEvent, weekday: 'long' | 'short') => {
  const day: Intl.DateTimeFormatOptions = { timeZone: event.timezone, weekday, day: 'numeric', month: 'long' }
  if (isMultiDay(event)) return new Intl.DateTimeFormat(dateLocales[locale], day).formatRange(event.startAt, event.endAt)
  return `${format(event, day)} · ${formatTime(event)}`
}
const formatTime = (event: ListedEvent) => {
  const time: Intl.DateTimeFormatOptions = { hour: locale === 'en' ? 'numeric' : '2-digit', minute: '2-digit', hour12: locale === 'en' }
  const start = format(event, time)
  const end = format(event, time, event.endAt)
  if (locale === 'de') return `${start}–${end} Uhr`
  // "3:00–7:30 pm": the am/pm marker is written once when both times share it.
  const [startClock, startPeriod] = start.split(/\s/)
  return startPeriod === end.split(/\s/)[1] ? `${startClock}–${end}` : `${start}–${end}`
}
---

<DefaultLayout title={pageMeta.events.title} description={pageMeta.events.description} url="events">
  <PageHeader title={copy.title} lead={copy.lead} />
  {
    groups.map((group) => (
      <Section tone={group.past ? 'default' : 'subtle'} labelledby={group.headingId}>
        <div class="events-head">
          <h2 id={group.headingId} class="text-display-sm">{group.heading}</h2>
          {!group.past && (
            <Button href={lumaCalendarUrl} variant="outline" icon="ion:calendar-outline" target="_blank" rel="noopener">{copy.followCalendar}</Button>
          )}
        </div>

        {
          group.events.length === 0 ? (
            <p class="events-empty">{events === null ? copy.unavailable : copy.empty}</p>
          ) : (
            <ul class="events-list">
              {group.events.map((event, index) => {
                const featured = !group.past && isFeatured(index)
                return (
                <li class:list={['event', { 'event--featured': featured }]}>
                  <div class="event-media">
                    {event.coverUrl && <img src={event.coverUrl} alt="" loading={!group.past && index < 4 ? 'eager' : 'lazy'} />}
                    <span class="event-date">
                      <span class="event-day">{format(event, { day: '2-digit' })}</span>
                      <span class="event-month">{format(event, { month: 'short' }).replace('.', '')}</span>
                    </span>
                  </div>
                  <div class="event-content">
                    <time class="event-time" datetime={event.startAt.toISOString()}>
                      {group.past ? format(event, { day: 'numeric', month: 'long', year: 'numeric' }) : formatWhen(event, featured ? 'long' : 'short')}
                    </time>
                    <h3><a href={event.url} target="_blank" rel="noopener">{event.name}</a></h3>
                    <ul class="event-facts">
                      {event.location && <li><Icon name="ion:location-outline" aria-hidden="true" /><span>{event.location}</span></li>}
                      {(featured || group.past) && 'guestCount' in event && event.guestCount > 0 && (
                        <li><Icon name="ion:people-outline" aria-hidden="true" /><span>{event.guestCount} {group.past ? copy.attended : copy.guests}</span></li>
                      )}
                      {!group.past && event.isFree && <li><Icon name="ion:ticket-outline" aria-hidden="true" /><span>{copy.free}</span></li>}
                    </ul>
                    {group.past ? null : 'isSoldOut' in event && event.isSoldOut ? (
                      <span class="event-soldout">{copy.soldOut}</span>
                    ) : (
                      <Button
                        href={'registerUrl' in event ? event.registerUrl : event.url}
                        target="_blank"
                        rel="noopener"
                        variant={featured ? 'primary' : 'outline'}
                        size={featured ? 'md' : 'sm'}
                        icon="ion:arrow-forward"
                      >
                        {copy.register}
                      </Button>
                    )}
                  </div>
                </li>
                )
              })}
            </ul>
          )
        }
      </Section>
    ))
  }

</DefaultLayout>

<style>
  .events-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 2rem; margin-bottom: 2.5rem; }
  .events-empty { padding: 2rem; color: var(--color-fg-muted); border: 1px dashed var(--color-border); border-radius: var(--radius-card); }

  .events-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .event {
    display: flex; flex-direction: column; gap: 1.25rem; min-width: 0; padding: 1.25rem;
    border: 1px solid transparent; border-radius: var(--radius-card);
    background: linear-gradient(var(--color-card), var(--color-card)) padding-box, linear-gradient(var(--color-border), var(--color-border)) border-box;
    transition: transform .3s ease, box-shadow .3s ease;
  }
  .event--featured { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 2rem; padding: 1.5rem; }

  .event-media { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: calc(var(--radius-card) - .25rem); background: var(--gradient-brand); }
  .event-media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .event-date {
    position: absolute; top: .75rem; left: .75rem; display: flex; flex-direction: column; align-items: center; min-width: 3.5rem; padding: .5rem .6rem .45rem;
    color: #fff; line-height: 1; border-radius: .8rem; background: var(--gradient-brand); box-shadow: 0 10px 30px rgb(0 0 0 / .35);
  }
  .event-day { font-size: 1.5rem; font-weight: 700; letter-spacing: -.03em; }
  .event-month { margin-top: .25rem; font-size: .65rem; font-weight: 650; letter-spacing: .12em; text-transform: uppercase; }
  .event--featured .event-date { top: 1rem; left: 1rem; min-width: 4.25rem; padding: .6rem .75rem .5rem; border-radius: .9rem; }
  .event--featured .event-day { font-size: 2rem; }
  .event--featured .event-month { margin-top: .3rem; font-size: .75rem; }

  .event-content { display: flex; flex: 1; flex-direction: column; align-items: flex-start; min-width: 0; }
  .event--featured .event-content { justify-content: center; }
  .event-time { color: var(--color-accent-text); font-size: .7rem; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; }
  /* The title link covers the card; the register button sits above it. */
  .event { position: relative; }
  .event-content h3 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .event-content :global(.btn), .event-soldout { position: relative; z-index: 1; }
  .event-content h3 { margin: .6rem 0 1rem; font-size: 1.15rem; font-weight: 600; line-height: 1.25; letter-spacing: -.02em; }
  .event--featured .event-content h3 { margin: .75rem 0 1.25rem; font-size: var(--text-xl); }
  .event-facts { display: grid; gap: .5rem; margin: 0 0 1.5rem; color: var(--color-fg-muted); font-size: var(--text-sm); }
  .event--featured .event-facts { margin-bottom: 1.75rem; }
  .event-facts li { display: flex; align-items: center; gap: .6rem; min-width: 0; }
  .event-facts span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .event-facts :global(svg) { flex: none; width: 1.1rem; height: 1.1rem; color: var(--color-accent-text); }
  .event:not(.event--featured) .event-content > :last-child { margin-top: auto; }
  .event-soldout { padding: .6rem 1.1rem; color: var(--color-fg-muted); font-weight: 650; border: 1px solid var(--color-border); border-radius: 999px; }

  @media (hover: hover) {
    .event:hover {
      background: linear-gradient(var(--color-card), var(--color-card)) padding-box, var(--gradient-brand) border-box;
      transform: translateY(-2px); box-shadow: var(--shadow-card-hover);
    }
    .event:hover .event-media img { transform: scale(1.04); }
  }
  @media (max-width: 1023px) { .events-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) {
    .events-list { grid-template-columns: 1fr; }
    .event--featured { grid-template-columns: 1fr; gap: 1.25rem; padding: 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .event, .event-media img { transition: none; }
    .event:hover, .event:hover .event-media img { transform: none; }
  }
</style>
