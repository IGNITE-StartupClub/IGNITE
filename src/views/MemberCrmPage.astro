---
/**
 * The CRM tab of the Netzwerk section, rendered on demand by pages/mitglieder/netzwerk/index.astro and
 * pages/en/members/network/index.astro. Every signed-in member sees it (src/middleware.ts). The contacts are rendered
 * from the database and handed to the CrmBoard island, which talks to /api/members/crm.
 * Data source: memberArea.crm via getCopy(), contacts via contactState().
 */
import MemberNetworkLayout from '../layouts/MemberNetworkLayout.astro'
import CrmBoard from '../components/forms/CrmBoard.jsx'
import { getCopy } from '../data/copy'
import { berlinDay } from '../lib/contacts'
import { contactState } from '../lib/contactsStore'
import { resolveLocale } from '../lib/i18n'

const locale = resolveLocale(Astro.currentLocale)
const { crm } = getCopy(locale).memberArea
const { revision, contacts } = await contactState(Astro.locals.member!)
---

<MemberNetworkLayout tab="crm">
  <CrmBoard client:load copy={crm.board} initialContacts={contacts} initialRevision={revision} locale={locale} today={berlinDay(Date.now())} />
</MemberNetworkLayout>
