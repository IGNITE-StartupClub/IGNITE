---
/**
 * Member management, rendered on demand by pages/mitglieder/verwaltung.astro and pages/en/members/admin.astro.
 * src/middleware.ts lets only members with the admin role in; /api/members/admin checks the role again.
 * The list is rendered from the database and handed to the MemberAdmin island.
 * Data source: memberArea via getCopy(), members via listMembers().
 */
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import Section from '../components/ui/Section.astro'
import MemberAdmin from '../components/forms/MemberAdmin.jsx'
import { getCopy } from '../data/copy'
import { resolveLocale } from '../lib/i18n'
import { memberHomePath, memberPagePath } from '../lib/memberAuth'
import { listMembers, memberSummary } from '../lib/members'

const locale = resolveLocale(Astro.currentLocale)
const { admin } = getCopy(locale).memberArea
const members = (await listMembers()).map(memberSummary)
---

<DefaultLayout title={admin.pageTitle} alternatePath={memberPagePath('admin', locale === 'de' ? 'en' : 'de')} noindex>
  <PageHeader title={admin.title} lead={admin.lead}>
    <p class="form-note"><a href={memberHomePath(locale)}>{admin.back}</a></p>
  </PageHeader>
  <Section tone="subtle" width="article" spacing="sm" labelledby="page-title">
    <MemberAdmin client:load copy={admin.manager} initialMembers={members} currentEmail={Astro.locals.member!.email} locale={locale} />
  </Section>
</DefaultLayout>
