---
/**
 * Members area start page, rendered on demand by pages/mitglieder/index.astro and pages/en/members/index.astro.
 * Only reachable with a session: src/middleware.ts redirects everyone else to the login page and sets
 * Astro.locals.member. Without a team it shows the team choice; with ?team from the profile menu and the team chip the
 * same form is the settings page. The board has no team and never sees it.
 * Otherwise the dashboard (greeting, figures, next tasks, next event). The tools are in the header pill, account actions
 * (member management for admins, settings, mail signature, password, sign out) in its profile menu.
 * Data source: memberArea.home and openTeams via getCopy(), tasks via assignedProjects() and privateTasks(), events via
 * loadTaskEvents().
 */
import DefaultLayout from '../layouts/DefaultLayout.astro'
import Section from '../components/ui/Section.astro'
import MemberDashboard from '../components/forms/MemberDashboard.jsx'
import TeamChoice from '../components/forms/TeamChoice.jsx'
import { teamIconPath } from '../data/brandKit'
import { getCopy } from '../data/copy'
import { teamNames } from '../data/openTeams'
import { photoPath } from '../lib/emailSignature'
import { resolveLocale } from '../lib/i18n'
import { memberHomePath, memberPagePath } from '../lib/memberAuth'
import { dayLabel, eventDate, nextEvent, openTasks, showsTeamChoice, splitName } from '../lib/memberHome'
import { displayName } from '../lib/members'
import { loadTaskEvents } from '../lib/taskEvents'
import { berlinDay, isEvent, type TeamId } from '../lib/tasks'
import { privateTasks } from '../lib/privateTasksStore'
import { assignedProjects, sessionActor } from '../lib/tasksStore'

const TEAM_ICONS: Record<TeamId, string> = {
  'ignite-relations': teamIconPath('relations'),
  'ignite-marketing': teamIconPath('marketing'),
  'ignite-hr': teamIconPath('community'),
  'ignite-finance-legal': teamIconPath('finance'),
  'ignite-infrastructure': teamIconPath('organisation'),
}
const BOARD_ICON = teamIconPath('board')

const locale = resolveLocale(Astro.currentLocale)
const { memberArea, openTeams } = getCopy(locale)
const { home } = memberArea
const member = Astro.locals.member!
const actor = sessionActor(member)

const homeUrl = memberHomePath(locale)
const guessedName = splitName(displayName(member))
const greeting = member.firstName || guessedName.firstName
const team = openTeams.find(({ id }) => id === member.team)
const board = member.position === 'board'
const choosing = showsTeamChoice(!!team, board, Astro.url.searchParams.has('team'))

const names = teamNames(openTeams)
const teamChoices = openTeams.map(({ id }) => ({
  id,
  name: names[id],
  text: home.teamChoice.teams[id as TeamId],
  icon: TEAM_ICONS[id as TeamId],
}))

const now = Date.now()
const today = berlinDay(now)
const [{ events, complete }, projects, ownTasks] = choosing
  ? [{ events: [], complete: true }, [], []]
  : await Promise.all([loadTaskEvents(locale), assignedProjects(actor), privateTasks(actor.id)])

const tasks = openTasks(projects, actor.id, today, ownTasks).map((task) => ({
  ...task,
  dueLabel: task.due === today ? home.dashboard.next.today : task.due && dayLabel(task.due, locale),
}))
const upcoming = nextEvent(events.filter(isEvent), now)
const upcomingDate = upcoming && eventDate(upcoming.startAt, locale)
const event = upcoming &&
  upcomingDate && {
    id: upcoming.id,
    title: upcoming.title,
    month: upcomingDate.month,
    day: upcomingDate.day,
    when: `${upcomingDate.weekdayDay} · ${home.dashboard.event.time.replace('{time}', upcomingDate.time)}`,
  }

const tasksUrl = memberPagePath('tasks', locale)
---

<DefaultLayout title={memberArea.pageTitle} noindex>
  <Section spacing="xs" labelledby="page-title">
    {
      choosing ? (
        <TeamChoice
          client:load
          copy={home.teamChoice}
          photoCopy={{ ...memberArea.signature.generator.photo, ...home.teamChoice.photo }}
          optional={memberArea.signature.generator.optional}
          welcome={home.welcome}
          name={greeting}
          teams={teamChoices}
          current={{
            firstName: member.firstName ?? guessedName.firstName,
            lastName: member.lastName ?? guessedName.lastName,
            team: team?.id ?? '',
            photo: member.photoId ? photoPath(member.photoId) : '',
          }}
          changing={!!team}
          homeUrl={homeUrl}
          signatureUrl={memberPagePath('signature', locale)}
        />
      ) : (
        <MemberDashboard
          client:load
          copy={home.dashboard}
          welcome={home.welcome}
          name={greeting}
          team={
            team
              ? { name: team.team, icon: TEAM_ICONS[team.id as TeamId] }
              : { name: home.dashboard.board, icon: BOARD_ICON }
          }
          tasks={tasks}
          today={today}
          event={event}
          eventsComplete={complete}
          links={{
            team: board ? '' : `${homeUrl}?team`,
            mine: `${tasksUrl}?ansicht=meine`,
            tasks: `${tasksUrl}?ansicht=aufgaben`,
            events: `${tasksUrl}?ansicht=events`,
            project: tasksUrl,
          }}
        />
      )
    }
  </Section>
</DefaultLayout>
