---
/**
 * Members area start page, rendered on demand by pages/mitglieder/index.astro and pages/en/members/index.astro.
 * Only reachable with a session: src/middleware.ts redirects everyone else to the login page and sets
 * Astro.locals.member. Shows a card per tool of the area; member management only for admins. Account actions
 * (password, sign out) live in the profile menu of the header pill.
 * Data source: memberArea via getCopy().
 */
import { Icon } from 'astro-icon/components'
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import Section from '../components/ui/Section.astro'
import Card from '../components/ui/Card.astro'
import { getCopy } from '../data/copy'
import { resolveLocale } from '../lib/i18n'
import { memberPagePath } from '../lib/memberAuth'

const locale = resolveLocale(Astro.currentLocale)
const { memberArea } = getCopy(locale)
const { home } = memberArea
const { role } = Astro.locals.member!

const cards = [
  { ...home.cards.crm, icon: 'ion:briefcase-outline', url: memberPagePath('crm', locale) },
  { ...home.cards.alumni, icon: 'ion:school-outline', url: memberPagePath('alumni', locale) },
  { ...home.cards.team, icon: 'ion:people-circle-outline', url: memberPagePath('team', locale) },
  { ...home.cards.guide, icon: 'ion:book-outline', url: memberPagePath('guide', locale) },
  { ...home.cards.branding, icon: 'ion:color-palette-outline', url: memberPagePath('branding', locale) },
  { ...home.cards.benefits, icon: 'ion:gift-outline', url: memberPagePath('benefits', locale) },
  { ...home.cards.signature, icon: 'ion:mail-outline', url: memberPagePath('signature', locale) },
  ...(role === 'admin'
    ? [{ ...home.cards.admin, icon: 'ion:shield-checkmark-outline', url: memberPagePath('admin', locale) }]
    : []),
]
---

<DefaultLayout title={memberArea.pageTitle} noindex>
  <PageHeader compact compact title={home.title} lead={home.lead} />
  <Section tone="subtle" spacing="xs" labelledby="member-tools">
    <h2 id="member-tools" class="sr-only">{home.cardsHeading}</h2>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        cards.map((card) => (
          <Card as="li" class="h-full">
            <Icon slot="icon" name={card.icon} aria-hidden="true" />
            <h3 slot="title" class="text-xl hyphens-auto">
              {/* The link stretches over the whole card, so the card is one click target. */}
              <a href={card.url} class="after:absolute after:inset-0 after:content-['']">
                {card.title}
              </a>
            </h3>
            <p class="text-fg-muted">{card.text}</p>
          </Card>
        ))
      }
    </ul>
  </Section>
</DefaultLayout>
