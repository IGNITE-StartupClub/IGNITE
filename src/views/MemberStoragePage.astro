---
/**
 * The Ablage of the members area, rendered on demand by pages/mitglieder/ablage.astro and pages/en/members/files.astro:
 * the SharePoint folders on top (one per team, the member's own team first, a few for everyone, then the open projects
 * and events with their folder), below them the brand kit with logos, mark, profile pictures and team icons to
 * download, colours, fonts and a few rules. Admins keep the folder links on the member management page
 * (storageFolders.ts); a project's link is set in the project itself (folderUrl). Only Leuphana SharePoint links pass,
 * so every folder needs a sign-in. The previews sit on a light or dark tile depending on the logo colour, in both themes.
 * Data source: storageFolders() and projectFolders() in one wave, brandGroups (brandKit.ts, files in public/brand),
 * memberArea.storage and .branding via getCopy().
 */
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import Section from '../components/ui/Section.astro'
import { Icon } from 'astro-icon/components'
import { BRAND_PATH, brandGroups, TEAM_ICONS, teamIconPath } from '../data/brandKit'
import { getCopy } from '../data/copy'
import { teamNames } from '../data/openTeams'
import { resolveLocale } from '../lib/i18n'
import { memberHomePath, memberPagePath } from '../lib/memberAuth'
import { storageFolders } from '../lib/settingsStore'
import { TEAM_IDS, type TeamId } from '../lib/tasks'
import { projectFolders } from '../lib/tasksStore'

const locale = resolveLocale(Astro.currentLocale)
const { memberArea, openTeams } = getCopy(locale)
const { branding, storage, nav } = memberArea
const member = Astro.locals.member!
const [folders, projects] = await Promise.all([storageFolders(), projectFolders()])
const names = teamNames(openTeams)
const myTeam = member.team as TeamId | undefined
const teams = [...TEAM_IDS].sort((a, b) => Number(b === myTeam) - Number(a === myTeam))
const linked = projects.filter((project) => project.folderUrl)
const unlinked = projects.length - linked.length
const admin = member.role === 'admin'
// Project folders are set in the projects, so only the links on the admin page count here.
const missingLink = !folders.root || TEAM_IDS.some((team) => !folders.teams[team])
const shortDay = new Intl.DateTimeFormat(locale === 'de' ? 'de-DE' : 'en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' })
const projectMeta = (day: string, team: string) =>
  [day && shortDay.format(new Date(`${day}T00:00:00Z`)), team && names[team]].filter(Boolean).join(' · ')
const jumps = [
  ...brandGroups.map(({ id }) => ({ id: `brand-${id}`, label: branding.groups[id].heading })),
  { id: 'brand-colors', label: branding.colorsHeading },
  { id: 'brand-fonts', label: branding.fontsHeading },
]

const downloadLabel = (name: string, format: string) =>
  branding.downloadLabel.replace('{name}', name).replace('{format}', format)
const rgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16)).join(', ')
// The badge's fixed dark, so the white logo reads the same in both themes.
const TILE = { light: 'bg-white', dark: 'bg-[#0c0b0e]' }
const BUTTON =
  'inline-flex h-9 items-center gap-1.5 rounded-lg border border-border-strong px-3 text-sm font-medium text-fg no-underline transition-colors hover:bg-bg-subtle'
const ROW = 'flex items-center gap-3.5 px-5 py-4 text-fg no-underline sm:px-6'
---

<DefaultLayout
  title={storage.pageTitle}
  alternatePath={memberPagePath('storage', locale === 'de' ? 'en' : 'de')}
  noindex
>
  <PageHeader compact title={storage.title} lead={storage.lead}>
    <p class="form-note"><a href={memberHomePath(locale)}>{storage.back}</a></p>
  </PageHeader>

  <Section tone="subtle" spacing="xs" labelledby="storage-teams">
    {
      folders.root && (
        <a href={folders.root} target="_blank" rel="noopener noreferrer" class="mb-8 inline-flex min-h-11 items-center gap-2 rounded-xl bg-brand-bright px-4 font-semibold text-white no-underline hover:opacity-90">
          {storage.openAll}
          <Icon name="ion:open-outline" class="h-4 w-4" aria-hidden="true" />
          <span class="sr-only"> ({nav.newTab})</span>
        </a>
      )
    }
    {
      admin && missingLink && (
        <p class="mb-6 text-sm text-fg-muted">
          {storage.adminHint} <a href={`${memberPagePath('admin', locale)}#ablage`}>{storage.adminLink}</a>
        </p>
      )
    }

    <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <h2 id="storage-teams" class="text-[26px] font-semibold">{storage.teams.heading}</h2>
      <p class="text-sm text-fg-muted">{storage.teams.text}</p>
    </div>
    <ul role="list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {
        teams.map((team) => {
          const url = folders.teams[team]
          const mine = team === myTeam
          return (
            <li
              class:list={[
                'relative flex flex-col gap-4 rounded-card border bg-card p-5',
                mine ? 'border-brand-bright' : 'border-border',
                url && 'transition-colors hover:border-border-strong',
              ]}
            >
              <span class="flex items-center justify-between gap-2">
                <img src={teamIconPath(TEAM_ICONS[team])} alt="" width="48" height="48" class="h-12 w-12 rounded-full" />
                {mine && <span class="rounded-full bg-brand-deep px-2.5 py-1 text-2xs font-semibold text-white">{storage.teams.mine}</span>}
              </span>
              <span>
                {url ? (
                  <a href={url} target="_blank" rel="noopener noreferrer" class="block text-[18px] font-semibold leading-snug text-fg no-underline after:absolute after:inset-0 after:content-['']">
                    {names[team]}
                    <span class="sr-only"> ({nav.newTab})</span>
                  </a>
                ) : (
                  <span class="block text-[18px] font-semibold leading-snug">{names[team]}</span>
                )}
                <span class="mt-1 block text-sm text-fg-muted">
                  {url ? storage.open : storage.pending}
                  {url && <Icon name="ion:open-outline" class="ml-1 inline h-3.5 w-3.5 align-[-2px]" aria-hidden="true" />}
                </span>
              </span>
            </li>
          )
        })
      }
    </ul>

    <div class="mt-10 grid items-start gap-6 lg:grid-cols-2">
      <section aria-labelledby="storage-general" class="overflow-hidden rounded-card border border-border bg-card">
        <div class="px-5 pb-3 pt-5 sm:px-6">
          <h2 id="storage-general" class="text-[22px] font-semibold">{storage.general.heading}</h2>
          <p class="mt-1 text-sm text-fg-muted">{storage.general.text}</p>
        </div>
        {
          folders.general.length ? (
            <ul role="list">
              {folders.general.map(({ name, url }) => (
                <li class="border-t border-border">
                  <a href={url} target="_blank" rel="noopener noreferrer" class:list={[ROW, 'hover:bg-bg-subtle']}>
                    <span aria-hidden="true" class="surface-brand grid h-10 w-10 shrink-0 place-items-center rounded-xl">
                      <Icon name="ion:folder-outline" class="h-5 w-5" />
                    </span>
                    <span class="min-w-0 flex-1 truncate text-[17px] font-semibold">{name}</span>
                    <Icon name="ion:open-outline" class="h-4 w-4 shrink-0 text-accent" aria-hidden="true" />
                    <span class="sr-only"> ({nav.newTab})</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="border-t border-border px-5 py-4 text-sm text-fg-muted sm:px-6">{storage.general.empty}</p>
          )
        }
      </section>

      <section aria-labelledby="storage-projects" class="overflow-hidden rounded-card border border-border bg-card">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-5 pb-3 pt-5 sm:px-6">
          <div>
            <h2 id="storage-projects" class="text-[22px] font-semibold">{storage.projects.heading}</h2>
            <p class="mt-1 text-sm text-fg-muted">{storage.projects.text}</p>
          </div>
          <a href={`${memberPagePath('tasks', locale)}?ansicht=projekte`} class="text-sm font-medium">{storage.projects.toProjects}</a>
        </div>
        <ul role="list">
          {
            linked.map((project) => (
              <li class="border-t border-border">
                <a href={project.folderUrl} target="_blank" rel="noopener noreferrer" class:list={[ROW, 'hover:bg-bg-subtle']}>
                  <span class:list={['w-16 shrink-0 text-2xs font-semibold uppercase tracking-wide', project.type === 'event' ? 'text-accent' : 'text-fg-muted']}>
                    {storage.projects.kinds[project.type === 'event' ? 'event' : 'internal']}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-[17px] font-semibold">{project.title}</span>
                    {projectMeta(project.day, project.team) && <span class="block text-sm text-fg-muted">{projectMeta(project.day, project.team)}</span>}
                  </span>
                  <Icon name="ion:open-outline" class="h-4 w-4 shrink-0 text-accent" aria-hidden="true" />
                  <span class="sr-only"> ({nav.newTab})</span>
                </a>
              </li>
            ))
          }
          {!linked.length && <li class="border-t border-border px-5 py-4 text-sm text-fg-muted sm:px-6">{storage.projects.empty}</li>}
          {
            unlinked > 0 && (
              <li class="flex items-center gap-3 border-t border-border px-5 py-4 text-sm text-fg-muted sm:px-6">
                <span aria-hidden="true" class="h-2 w-2 shrink-0 rounded-full bg-brand-bright" />
                {unlinked === 1 ? storage.projects.missingOne : storage.projects.missing.replace('{count}', String(unlinked))}
              </li>
            )
          }
        </ul>
      </section>
    </div>
  </Section>

  <Section spacing="xs" labelledby="storage-branding">
    <h2 id="storage-branding" class="text-display-sm">{branding.title}</h2>
    <p class="mt-2 text-fg-muted">{branding.lead}</p>
    <nav aria-label={storage.brandingJump} class="mt-5">
      <ul role="list" class="flex flex-wrap gap-2">
        {
          jumps.map(({ id, label }) => (
            <li>
              <a href={`#${id}`} class="inline-flex min-h-10 items-center rounded-full border border-border-strong px-4 text-sm text-fg no-underline hover:bg-bg-subtle">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Section>

  {
    brandGroups.map(({ id, assets }, index) => (
      <Section tone={index % 2 === 0 ? 'subtle' : undefined} spacing="sm" labelledby={`brand-${id}`}>
        <h3 id={`brand-${id}`} class="text-[24px] font-semibold">
          {branding.groups[id].heading}
        </h3>
        <p class="mb-6 mt-2 text-fg-muted">{branding.groups[id].text}</p>
        <ul
          class:list={[
            'grid gap-4',
            id === 'teams' ? 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-5' : 'sm:grid-cols-2 lg:grid-cols-3',
          ]}
        >
          {assets.map((asset) => {
            const name = branding.assets[asset.id]
            return (
              <li class="flex flex-col overflow-hidden rounded-card border border-border bg-bg">
                {/* The image fills the tile absolutely: Safari ignores max-height: 100% inside an aspect-ratio box,
                    which let the icons grow the tile and slide off centre. */}
                <div class:list={['relative aspect-video', TILE[asset.tone]]}>
                  <img
                    src={BRAND_PATH + asset.preview}
                    alt=""
                    loading="lazy"
                    class="absolute inset-0 h-full w-full object-contain p-6"
                  />
                </div>
                <div class="flex flex-1 flex-col gap-3 border-t border-border p-4">
                  <h4 class="text-base font-semibold">{name}</h4>
                  <div class="mt-auto flex flex-wrap gap-2">
                    {asset.files.map(({ format, file, detail }) => (
                      <a href={BRAND_PATH + file} download class={BUTTON} aria-label={downloadLabel(name, format)}>
                        {format}
                        {detail && <span class="font-normal text-fg-subtle">{detail}</span>}
                      </a>
                    ))}
                  </div>
                </div>
              </li>
            )
          })}
        </ul>
      </Section>
    ))
  }

  <Section tone="subtle" spacing="sm" labelledby="brand-colors">
    <h2 id="brand-colors" class="mb-6 text-display-sm">{branding.colorsHeading}</h2>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        branding.colors.map(({ name, hex, use }) => (
          <li class="flex overflow-hidden rounded-card border border-border bg-bg">
            <span aria-hidden="true" class="w-20 shrink-0 border-r border-border" style={{ backgroundColor: hex }} />
            <div class="flex flex-col gap-1 p-4">
              <h3 class="text-base font-semibold">{name}</h3>
              <p class="select-all font-mono text-sm">{hex}</p>
              <p class="font-mono text-xs text-fg-subtle">RGB {rgb(hex)}</p>
              <p class="text-sm text-fg-muted">{use}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section spacing="sm" labelledby="brand-fonts">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <h2 id="brand-fonts" class="mb-6 text-display-sm">{branding.fontsHeading}</h2>
        <ul class="grid gap-4">
          {
            branding.fonts.map(({ name, use, url }) => (
              <li class="rounded-card border border-border bg-bg p-5">
                <p class:list={['text-3xl', name.startsWith('Newsreader') ? 'font-accent italic' : 'font-semibold']}>
                  Aa Bb Cc 123
                </p>
                <h3 class="mt-3 text-base font-semibold">{name}</h3>
                <p class="text-sm text-fg-muted">{use}</p>
                <a href={url} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm">
                  {branding.fontLink}
                  <span class="sr-only"> ({nav.newTab})</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="mb-6 text-display-sm">{branding.rulesHeading}</h2>
        <ul class="grid gap-3">
          {
            branding.rules.map((rule) => (
              <li class="flex gap-3 rounded-card border border-border bg-bg p-4 text-fg-muted">
                <span aria-hidden="true" class="mt-2 h-2 w-2 shrink-0 rounded-full bg-brand-bright" />
                {rule}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>
</DefaultLayout>
