---
/**
 * Upcoming events, loaded live from the IGNITE Luma calendar (src/lib/luma.ts).
 * Rendered per request and cached at the edge, so new Luma events appear without a deploy.
 * The next event is shown large, later ones in a grid. "Jetzt anmelden" opens Luma's
 * registration embed inside a site-styled <dialog>; without JS the button links to the Luma page.
 */
import { Icon } from 'astro-icon/components'
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import Section from '../components/ui/Section.astro'
import Button from '../components/ui/Button.astro'
import { getUpcomingEvents, lumaCalendarUrl, type LumaEvent } from '../lib/luma'
import { eventsPage as copy } from '../data/staticContent'

export const prerender = false

let events: LumaEvent[] | null
try {
  events = await getUpcomingEvents()
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=900, stale-while-revalidate=86400')
} catch (error) {
  // An unreachable Luma must not take the page down: log it and show the link to the calendar instead.
  console.error('Loading Luma events failed', error)
  events = null
}

const format = (event: LumaEvent, options: Intl.DateTimeFormatOptions, date = event.startAt) =>
  date.toLocaleString('de-DE', { timeZone: event.timezone, ...options })
const formatTime = (event: LumaEvent) =>
  `${format(event, { hour: '2-digit', minute: '2-digit' })}–${format(event, { hour: '2-digit', minute: '2-digit' }, event.endAt)} Uhr`
---

<DefaultLayout title="Events" description="Workshops, Austausch und Hackathons rund ums Gründen an der Leuphana." url="events">
  <PageHeader title={copy.title} lead={copy.lead} />
  <Section tone="subtle" labelledby="events-heading">
    <div class="events-head">
      <h2 id="events-heading" class="text-display-sm">{copy.heading}</h2>
      <Button href={lumaCalendarUrl} variant="outline" icon="ion:calendar-outline" target="_blank" rel="noopener">{copy.followCalendar}</Button>
    </div>

    {
      events === null || events.length === 0 ? (
        <p class="events-empty">{events === null ? copy.unavailable : copy.empty}</p>
      ) : (
        <ul class="events-list">
          {events.map((event, index) => (
            <li class:list={['event', { 'event--featured': index === 0 }]}>
              <a class="event-media" href={event.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                {event.coverUrl && <img src={event.coverUrl} alt="" loading={index < 4 ? 'eager' : 'lazy'} />}
                <span class="event-date">
                  <span class="event-day">{format(event, { day: '2-digit' })}</span>
                  <span class="event-month">{format(event, { month: 'short' }).replace('.', '')}</span>
                </span>
              </a>
              <div class="event-content">
                <time class="event-time" datetime={event.startAt.toISOString()}>
                  {format(event, { weekday: index === 0 ? 'long' : 'short', day: 'numeric', month: 'long' })} · {formatTime(event)}
                </time>
                <h3><a href={event.url} target="_blank" rel="noopener">{event.name}</a></h3>
                <ul class="event-facts">
                  {event.location && <li><Icon name="ion:location-outline" aria-hidden="true" /><span>{event.location}</span></li>}
                  {index === 0 && event.guestCount > 0 && <li><Icon name="ion:people-outline" aria-hidden="true" /><span>{event.guestCount} {copy.guests}</span></li>}
                  {event.isFree && <li><Icon name="ion:ticket-outline" aria-hidden="true" /><span>{copy.free}</span></li>}
                </ul>
                {event.isSoldOut ? (
                  <span class="event-soldout">{copy.soldOut}</span>
                ) : (
                  <Button
                    href={event.url}
                    target="_blank"
                    rel="noopener"
                    variant={index === 0 ? 'primary' : 'outline'}
                    size={index === 0 ? 'md' : 'sm'}
                    icon="ion:arrow-forward"
                    data-register-event={event.id}
                    data-event-name={event.name}
                  >
                    {copy.register}
                  </Button>
                )}
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </Section>

  <dialog class="register-dialog">
    <button type="button" class="register-close" data-register-close aria-label={copy.close}>
      <Icon name="ion:close" aria-hidden="true" />
    </button>
    <iframe class="register-frame" title={copy.register} data-register-frame></iframe>
  </dialog>
</DefaultLayout>

<script>
  // Opens Luma's registration embed in our own dialog, so the overlay matches the site and follows its theme.
  const dialog = document.querySelector<HTMLDialogElement>('.register-dialog')
  const frame = document.querySelector<HTMLIFrameElement>('[data-register-frame]')

  document.addEventListener('click', (event) => {
    const target = event.target as Element
    const trigger = target.closest<HTMLElement>('[data-register-event]')
    if (trigger && dialog && frame) {
      event.preventDefault()
      const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light'
      frame.src = `https://lu.ma/embed/event/${trigger.dataset.registerEvent}/simple?lt=${theme}`
      dialog.setAttribute('aria-label', `${trigger.dataset.eventName}: ${frame.title}`)
      dialog.showModal()
      return
    }
    // Close on the close button or a click on the backdrop (the dialog element itself, outside its content).
    if (dialog?.open && (target.closest('[data-register-close]') || target === dialog)) dialog.close()
  })

  dialog?.addEventListener('close', () => frame?.removeAttribute('src'))
</script>

<style>
  .events-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 2rem; margin-bottom: 2.5rem; }
  .events-empty { padding: 2rem; color: var(--color-fg-muted); border: 1px dashed var(--color-border); border-radius: var(--radius-card); }

  .events-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .event {
    display: flex; flex-direction: column; gap: 1.25rem; min-width: 0; padding: 1.25rem;
    border: 1px solid transparent; border-radius: var(--radius-card);
    background: linear-gradient(var(--color-card), var(--color-card)) padding-box, linear-gradient(var(--color-border), var(--color-border)) border-box;
    transition: transform .3s ease, box-shadow .3s ease;
  }
  .event--featured { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 2rem; padding: 1.5rem; }

  .event-media { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: calc(var(--radius-card) - .25rem); background: var(--gradient-brand); }
  .event-media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .event-date {
    position: absolute; top: .75rem; left: .75rem; display: flex; flex-direction: column; align-items: center; min-width: 3.5rem; padding: .5rem .6rem .45rem;
    color: #fff; line-height: 1; border-radius: .8rem; background: var(--gradient-brand); box-shadow: 0 10px 30px rgb(0 0 0 / .35);
  }
  .event-day { font-size: 1.5rem; font-weight: 700; letter-spacing: -.03em; }
  .event-month { margin-top: .25rem; font-size: .65rem; font-weight: 650; letter-spacing: .12em; text-transform: uppercase; }
  .event--featured .event-date { top: 1rem; left: 1rem; min-width: 4.25rem; padding: .6rem .75rem .5rem; border-radius: .9rem; }
  .event--featured .event-day { font-size: 2rem; }
  .event--featured .event-month { margin-top: .3rem; font-size: .75rem; }

  .event-content { display: flex; flex: 1; flex-direction: column; align-items: flex-start; min-width: 0; }
  .event--featured .event-content { justify-content: center; }
  .event-time { color: var(--color-accent-text); font-size: .7rem; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; }
  .event-content h3 { margin: .6rem 0 1rem; font-size: 1.15rem; font-weight: 600; line-height: 1.25; letter-spacing: -.02em; }
  .event--featured .event-content h3 { margin: .75rem 0 1.25rem; font-size: var(--text-xl); }
  .event-facts { display: grid; gap: .5rem; margin: 0 0 1.5rem; color: var(--color-fg-muted); font-size: var(--text-sm); }
  .event--featured .event-facts { margin-bottom: 1.75rem; }
  .event-facts li { display: flex; align-items: center; gap: .6rem; min-width: 0; }
  .event-facts span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .event-facts :global(svg) { flex: none; width: 1.1rem; height: 1.1rem; color: var(--color-accent-text); }
  .event:not(.event--featured) .event-content > :last-child { margin-top: auto; }
  .event-soldout { padding: .6rem 1.1rem; color: var(--color-fg-muted); font-weight: 650; border: 1px solid var(--color-border); border-radius: 999px; }

  @media (hover: hover) {
    .event:hover {
      background: linear-gradient(var(--color-card), var(--color-card)) padding-box, var(--gradient-brand) border-box;
      transform: translateY(-2px); box-shadow: var(--shadow-card-hover);
    }
    .event:hover .event-media img { transform: scale(1.04); }
  }
  @media (max-width: 1023px) { .events-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) {
    .events-list { grid-template-columns: 1fr; }
    .event--featured { grid-template-columns: 1fr; gap: 1.25rem; padding: 1.25rem; }
  }

  .register-dialog {
    position: fixed; width: min(30rem, calc(100% - 2rem)); height: min(50rem, calc(100dvh - 2rem)); max-height: none; padding: 0; overflow: hidden;
    border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-card);
    box-shadow: 0 30px 80px rgb(0 0 0 / .45);
  }
  .register-dialog[open] { display: flex; flex-direction: column; animation: register-in .25s ease; }
  .register-dialog::backdrop { background: rgb(10 10 14 / .6); backdrop-filter: blur(6px); }
  .register-close {
    position: absolute; top: .75rem; right: .75rem; z-index: 1; display: inline-flex; align-items: center; justify-content: center;
    width: 2.75rem; height: 2.75rem; padding: 0; color: #fff; border: 1px solid rgb(255 255 255 / .15); border-radius: 999px;
    background: rgb(20 20 24 / .55); backdrop-filter: blur(8px); cursor: pointer; transition: background-color .2s ease, transform .2s ease;
  }
  .register-close:hover { background: rgb(20 20 24 / .8); transform: scale(1.05); }
  .register-close :global(svg) { width: 1.3rem; height: 1.3rem; }
  .register-frame { flex: 1; width: 100%; border: 0; background: transparent; }
  @keyframes register-in { from { opacity: 0; transform: translateY(12px) scale(.98); } }

  @media (prefers-reduced-motion: reduce) {
    .event, .event-media img { transition: none; }
    .event:hover, .event:hover .event-media img { transform: none; }
    .register-dialog[open] { animation: none; }
  }
</style>
