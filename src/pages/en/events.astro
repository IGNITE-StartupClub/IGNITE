---
import EventsPage from '../../views/EventsPage.astro'
import { loadUpcomingEvents } from '../../lib/luma'

export const prerender = false

const events = await loadUpcomingEvents('en')
// Only cache a successful Luma response at the edge.
if (events) Astro.response.headers.set('Cache-Control', 'public, s-maxage=900, stale-while-revalidate=86400')
---

<EventsPage events={events} />
