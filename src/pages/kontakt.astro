---
import DefaultLayout from '../layouts/DefaultLayout.astro';
import Contact from '../components/Contact.jsx';
import CallToAction from '../components/CallToAction.astro';
import { contactPage } from '../data/staticContent';

const initialIntent = Astro.url.searchParams.get('intent') || '';

// Static contact page content
const pageTitle = contactPage.pageTitle;
const pageIntro = contactPage.pageIntro;

export const prerender = true;
---

<DefaultLayout title="Kontakt" description="Nimm Kontakt mit uns auf! Wir freuen uns über deine Nachricht und stehen dir gerne zur Verfügung.">
  <main class="mitmachen-container">
    <h1>{pageTitle}</h1>
    <div class="intro" set:html={pageIntro} />
    <Contact client:load initialIntent={initialIntent} />
    <CallToAction />

  </main>

  <style lang="css">
    .mitmachen-container {
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem;
      font-family: var(--font-sans);
      color: var(--color-text);
    }
    .intro {
      margin-bottom: 2rem;
      line-height: 1.6;
    }
    h1, h2 { 
      color: var(--color-primary);
    }
    .form-section {
      margin-top: 3rem;
    }
    #application-form {
      margin: 2rem 0 2rem 0;
    }
    .text-wrapper {
      margin-bottom: 2rem;
    }
    /* CSS-Variablen im globalen Stylesheet definiert */
  </style>
</DefaultLayout>