---
/**
 * Join page: header, open teams, application questionnaire, process steps.
 * Data sources: mitmachenPage (staticContent.ts), openTeams (data/openTeams.ts), questionnaireConfig.
 */
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import Section from '../components/ui/Section.astro'
import Button from '../components/ui/Button.astro'
import OpenTeamsGrid from '../components/mitmachen/OpenTeamsGrid.astro'
import ProcessSteps from '../components/mitmachen/ProcessSteps.astro'
import Questionnaire from '../components/forms/Questionnaire.jsx'
import { openTeams } from '../data/openTeams'
import { mitmachenPage as c } from '../data/staticContent'

export const prerender = true
---

<DefaultLayout
  title="Mitmachen"
  description="Wir freuen uns auf dich im Team von IGNITE, deinem Startup-Netzwerk in Lüneburg."
>
  <PageHeader title={c.title} lead={c.lead}>
    <div class="mt-10">
      <Button href="#bewerbung" size="lg">{c.ctaLabel}</Button>
    </div>
  </PageHeader>

  <Section tone="subtle" labelledby="teams-heading">
    <h2 id="teams-heading" class="max-w-text text-display-sm" set:html={c.teamsHeading} />
    <p class="mt-6 max-w-text text-lead text-fg-muted">{c.teamsLead}</p>
    <div class="mt-12"><OpenTeamsGrid teams={openTeams} /></div>
  </Section>

  <Section id="bewerbung" width="text" labelledby="form-heading">
    <h2 id="form-heading" class="text-display-sm" set:html={c.formHeading} />
    <p class="mt-6 text-fg-muted">{c.formLead}</p>
    <div class="mt-10"><Questionnaire client:load /></div>
  </Section>

  <Section tone="subtle" spacing="sm" labelledby="process-heading">
    <h2 id="process-heading" class="max-w-text text-display-sm" set:html={c.processHeading} />
    <p class="mt-6 max-w-text text-lead text-fg-muted">{c.processLead}</p>
    <ProcessSteps steps={c.steps} />
  </Section>
</DefaultLayout>
