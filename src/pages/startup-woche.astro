---
import StartupWeekPage from '../views/StartupWeekPage.astro'

// Rendered per request so the week switches by date without a deploy; the edge cache keeps it to a few calls an hour.
export const prerender = false
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400')
---

<StartupWeekPage />
