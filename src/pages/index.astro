---
import DefaultLayout from '../layouts/DefaultLayout.astro'
import Hero from '../components/Hero.astro'
import Feature from '../components/Feature.astro'
import News from '../components/news.astro'
import { Accordion, AccordionItem } from 'accessible-astro-components'
import AdvisoryBoard from '../components/AdvisoryBoard.jsx'
import Partners from '../components/partners.astro'

import ContentMedia from '../components/ContentMedia.astro'
import Events from '../components/events.astro'
import { Icon } from 'astro-icon/components'
import Counter from '../components/Counter.astro'
import Button from '../components/Button.astro'
import { Modal } from 'accessible-astro-components'
import { getFeatures, getFAQs } from '../lib/strapi/client'

// Fetch Features and FAQs from Strapi
const features = await getFeatures()
const faqs = await getFAQs()

// Fallback data if Strapi is unavailable
const defaultFeatures = [
  {
    icon: 'ion:diamond-outline',
    title: 'Workshops & Events',
    description: 'Wir lernen gemeinsam von Expert:innen & Peer-to-Peer über Startups und Entrepreneurship.\n\n<p class="text-neutral-500 my-3">Du willst einen Workshop im Rahmen unserer Initiative geben?</p>\n<a class="button secondary" href="/kontakt">Jetzt kontaktieren!</a>',
  },
  {
    icon: 'ion:document-attach-outline',
    title: 'Fact-Sheet',
    description: 'Wir analysieren die Angebote zum Thema Entrepreneurship an der Leuphana Universität.',
  },
  {
    icon: 'ion:flame-outline',
    title: 'Hackathon',
    description: 'Wir veranstalten einen Hackathon, um innovative Ideen zu entwickeln und zu testen. Wir organisieren 2-3 tägige Events, um in kurzer Zeit Startup Ideen auszuarbeiten.',
  },
  {
    icon: 'ion:mic-outline',
    title: 'IGNITE Podcast',
    description: 'Im Utopia interviewen wir Startup Gründende und Leuphana Alumni.',
  },
  {
    icon: 'ion:people-outline',
    title: 'Community',
    description: 'Wir verbinden Studierende, Alumni und Gründende mit dem Ziel, ein starkes Netzwerk aufzubauen.',
  },
  {
    icon: 'ion:cash-outline',
    title: 'IGNITE Stipendium',
    description: 'Wir möchten in Zukunft angehendenden Gründenden einen Co-Working Platz und Förderung im Utopia ermöglichen.\n\n<p class="text-neutral-500 my-3">Dafür suchen wir Partner:innen, die uns unterstützen.</p>\n<a class="button secondary" href="/kontakt">Partner werden</a>',
  },
]

const defaultFAQs = [
  {
    question: 'Was ist IGNITE?',
    answer: '<p>Wir sind eine studentische Initiative an der Leuphana Universität Lüneburg, die sich leidenschaftlich für Entrepreneurship und Startup-Kultur einsetzt. Unser Ziel ist es, Gründungsgeist zu fördern, Studierende zu vernetzen und praxisnahe Erfahrungen im Bereich Unternehmensgründung zu ermöglichen.</p>',
    openByDefault: true,
  },
  {
    question: 'Welche Erwartungen stellen wir an die Mitglieder?',
    answer: '<p>Der durchschnittliche Aufwand liegt bei etwa 3–5 Stunden pro Woche – je nach Projektphase etwas mehr oder weniger. Wir erwarten regelmäßige Teilnahme an Team-Meetings, aktive Projektarbeit und proaktive Kommunikation.</p>',
    openByDefault: false,
  },
  {
    question: 'Wie profitiere ich von meinem Ehrenamt?',
    answer: '<p>Du erhältst exklusiven Zugang zu Unternehmen, Gründer:innen, Investor:innen und Alumni, nimmst an praxisorientierten Workshops teil und erhältst individuelles Feedback in Mentoring-Sessions.</p>',
    openByDefault: false,
  },
  {
    question: 'Wie läuft der Bewerbungs- und Onboarding-Prozess ab?',
    answer: '<p>Du füllst das Online-Formular auf unserer Website aus, bekommst eine Rückmeldung per E-Mail mit Einladung zum persönlichen Gespräch und startest nach positiver Entscheidung mit einem strukturierten Onboarding.</p>',
    openByDefault: false,
  },
  {
    question: 'Welche Rollen und Gremien gibt es innerhalb der Initiative?',
    answer: '<p>Wir arbeiten in projektbezogenen Teams, die sich um verschiedene Themen kümmern, wie z.B. Workshops, Events, Podcast, Community-Building. Jedes Team hat eine:n Teamleiter:in, die/der für die Koordination verantwortlich ist.</p>',
    openByDefault: false,
  },
  {
    question: 'Kann man IGNITE sponsoren?',
    answer: '<p>Ja, wir suchen aktiv nach Sponsoren, die uns bei der Umsetzung unserer Projekte unterstützen. Wenn du Interesse hast, kontaktiere uns gerne über das <a href="/kontakt">Kontaktformular</a></p>',
    openByDefault: false,
  },
]

// Use Strapi data if available, otherwise fallback to defaults
const displayFeatures = features.length > 0 ? features : defaultFeatures
const displayFAQs = faqs.length > 0 ? faqs : defaultFAQs
---

<DefaultLayout title="IGNITE - Startup Club Lüneburg" description="Willkommen bei IGNITE - deiner studentischen Initiative für Entrepreneurship an der Leuphana Universität Lüneburg.">
  <Hero />
  <section class="my-64">
    <div class="container">
      <h2 class="mb-16 text-4xl md:text-6xl">Was wir machen</h2>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
        {displayFeatures.map((feature) => (
          <Feature icon={feature.icon} title={feature.title}>
            <Fragment set:html={feature.description} />
          </Feature>
        ))}
      </div>
    </div>
  </section>
  <AdvisoryBoard />
  <section>
  <News />
</section>
<!-- <Partners /> -->
  <!-- <ContentMedia imgSrc="/wcag-compliant.webp" reverseImg={true}>
    <h2>Absichtserklärung</h2>
    <p class="text-2xl">
      Ganz im Sinne der führenden Hochschulen setzen auch wir uns dafür ein, Gründungsgeist und Startup-Kultur an der Leuphana aktiv zu leben und langfristig zu etablieren. Bereits über 50 Uni-Mitglieder haben unsere Absichtserklärung unterzeichnet – sei dabei und gestalte mit uns die Gründerlandschaft von morgen!
    </p>

    <a class="button secondary has-icon max-w-max" href="/team">
      <Icon name="ion:pencil-outline" />
      Jetzt lesen!
    </a>

  </ContentMedia> -->
  <section class="my-64">
    <div class="container grid grid-cols-1 gap-12 md:grid-cols-2">
      <div class="flex flex-col items-start gap-4">
        <h2 class="text-6xl">FAQ</h2>
        <p class="text-2xl">
          Häufig gestellte Fragen zu IGNITE.
        </p>
        <a class="button color-secondary" href="/kontakt">Nimm Kontakt auf!</a>
      </div>
      <div class="space-content">
        <Accordion>
          {displayFAQs.map((faq) => (
            <AccordionItem name="exclusive" title={faq.question} open={faq.openByDefault}>
              <Fragment set:html={faq.answer} />
            </AccordionItem>
          ))}
        </Accordion>
      </div>
    </div>
  </section>
</DefaultLayout>
