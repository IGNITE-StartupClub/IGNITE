---
import DefaultLayout from '../layouts/DefaultLayout.astro'
import Hero from '../components/Hero.astro'
import Feature from '../components/Feature.astro'
import News from '../components/news.astro'
import { Accordion, AccordionItem } from 'accessible-astro-components'
import AdvisoryBoard from '../components/AdvisoryBoard.jsx'
import KPIDashboard from '../components/KPIDashboard.jsx'
import Partners from '../components/partners.astro'

import ContentMedia from '../components/ContentMedia.astro'
import Events from '../components/events.astro'
import { Icon } from 'astro-icon/components'
import Counter from '../components/Counter.astro'
import Button from '../components/Button.astro'
import { Modal } from 'accessible-astro-components'
import { features, faqs, homepage } from '../data/staticContent'
import { getCollection } from 'astro:content'

// Use static data directly
const displayFeatures = features
const displayFAQs = faqs

// Homepage content
const featuresHeading = homepage.featuresHeading
const faqHeading = homepage.faqHeading
const faqDescription = homepage.faqDescription
const faqCTA_Text = homepage.faqCTA_Text
const faqCTA_URL = homepage.faqCTA_URL
const showAdvisoryBoard = homepage.showAdvisoryBoard
const showNews = homepage.showNews

// Materialien preview — fetch & sort at build time
const allMaterials = await getCollection('materials')
const sortedMaterials = allMaterials
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3)
  .map((m) => ({
    tag: m.data.tag,
    date: new Date(m.data.date).toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' }),
    title: m.data.title,
    description: m.data.description,
    imageUrl: m.data.image,
    href: '/materialien/' + m.id,
  }))

export const prerender = true
---

<DefaultLayout title="IGNITE - Startup Club Lüneburg" description="Willkommen bei IGNITE - deiner studentischen Initiative für Entrepreneurship an der Leuphana Universität Lüneburg.">
  <Hero homepage={homepage} />
  <KPIDashboard client:visible />
  <!-- <Events /> -->
  <section class="my-64">
    <div class="container">
      <h2 class="mb-16 text-4xl md:text-6xl">{featuresHeading}</h2>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
        {displayFeatures.map((feature) => (
          <Feature icon={feature.icon} title={feature.title}>
            <Fragment set:html={feature.description} />
          </Feature>
        ))}
      </div>
    </div>
  </section>
  {showAdvisoryBoard && <AdvisoryBoard client:load />}
  {showNews && (
    <section>
      <News />
    </section>
  )}

  <!-- {sortedMaterials.length > 0 && (
    <section class="my-64">
      <div class="container">
        <h2 class="mb-16 text-4xl md:text-6xl">Materialien & Ressourcen</h2>
        <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3 mb-16">
          {sortedMaterials.map((m) => (
            <a href={m.href} class="material-card spotlight-card flex flex-col gap-4">
              {m.tag && <span class="material-tag">{m.tag}</span>}
              <div class="content">
