                <p>{m.description}</p>
              </div>
            </a>
          ))}
        </div>
        <div class="flex justify-center">
          <a class="button secondary" href="/materialien">Alle Ressourcen ansehen</a>
        </div>
      </div>
    </section>
  )} -->

