---
/**
 * Paginated materials list (9 per page) from the `materials` content collection.
 * Data source: src/content/materials, copy in listingPages.materials (staticContent.ts).
 */
import type { GetStaticPaths, Page } from 'astro'
import { getCollection, type CollectionEntry } from 'astro:content'
import DefaultLayout from '../../layouts/DefaultLayout.astro'
import PageHeader from '../../components/ui/PageHeader.astro'
import Section from '../../components/ui/Section.astro'
import Pagination from '../../components/ui/Pagination.astro'
import { listingPages } from '../../data/staticContent'
import { getMaterialCover } from '../../data/editorialAssets'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const materials = await getCollection('materials')
  const sorted = [...materials].sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  return paginate(sorted, { pageSize: 9 })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'materials'>>
}

const { page } = Astro.props
const copy = listingPages.materials
---

<DefaultLayout title="Materialien und Ressourcen" description={copy.lead} url="materialien">
  <PageHeader title={copy.title} lead={copy.lead} />
  <Section tone="subtle" labelledby="page-title">
    {
      page.data.length === 0 ? (
        <p class="text-fg-muted">{copy.empty}</p>
      ) : (
        <ul class="editorial-list">
          {page.data.map((item, index) => (
            <li class="editorial-item">
              <a class="editorial-image" href={`/materialien/${item.id}`} aria-label={`Material ansehen: ${item.data.title}`}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <img src={getMaterialCover(item.id, item.data.image)} alt={`Titelbild: ${item.data.title}`} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
              </a>
              <div class="editorial-content">
                <p class="editorial-meta">{item.data.tag || 'Ressource'} · {item.data.author?.replace('(AUTHOR)', '').trim() || 'IGNITE Team'}</p>
                <h2><a href={`/materialien/${item.id}`}>{item.data.title}</a></h2>
                <p>{item.data.description}</p>
                <a class="editorial-link" href={`/materialien/${item.id}`}>{copy.readMore} <span aria-hidden="true">↗</span></a>
              </div>
            </li>
          ))}
        </ul>
      )
    }
    <Pagination page={page} basePath="/materialien" label="Seiten der Materialien" />
  </Section>
</DefaultLayout>

<style>
  .editorial-list { display: grid; gap: clamp(2.5rem, 6vw, 6rem); max-width: 72rem; margin: 0 auto; }
  .editorial-item { display: grid; grid-template-columns: minmax(15rem, .9fr) minmax(0, 1.1fr); gap: clamp(1.5rem, 5vw, 5rem); align-items: center; padding-bottom: clamp(2.5rem, 6vw, 6rem); border-bottom: 1px solid var(--color-border); }
  .editorial-item:nth-child(even) { grid-template-columns: minmax(0, 1.1fr) minmax(15rem, .9fr); }
  .editorial-item:nth-child(even) .editorial-image { order: 2; }
  .editorial-image { position: relative; display: grid; place-items: center; min-height: clamp(16rem, 31vw, 27rem); overflow: hidden; background: var(--color-bg-subtle); border: 1px solid var(--color-border); }
  .editorial-image::after { content: ''; position: absolute; inset: 1rem; border: 1px solid color-mix(in srgb, var(--color-accent-text) 30%, transparent); pointer-events: none; }
  .editorial-image img { width: 78%; height: 78%; object-fit: contain; filter: drop-shadow(0 1.25rem 1.75rem rgb(0 0 0 / .2)); transition: transform .45s ease; }
  .editorial-image:hover img { transform: scale(1.06) rotate(-1deg); }
  .editorial-image span { position: absolute; top: 1rem; left: 1rem; z-index: 1; color: var(--color-fg-subtle); font-size: .75rem; letter-spacing: .12em; }
  .editorial-content { max-width: 34rem; }
  .editorial-meta { color: var(--color-accent-text); font-size: .75rem; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; }
  .editorial-content h2 { margin: .75rem 0 1rem; font-size: clamp(1.8rem, 3.4vw, 3.4rem); }
  .editorial-content h2 a:hover { color: var(--color-fg); }
  .editorial-content > p:not(.editorial-meta) { margin: 0; color: var(--color-fg-muted); }
  .editorial-link { display: inline-flex; gap: .45rem; margin-top: 1.5rem; color: var(--color-fg); font-size: .95rem; font-weight: 650; }
  .editorial-link:hover { color: var(--color-accent-text); }
  @media (max-width: 767px) { .editorial-item, .editorial-item:nth-child(even) { grid-template-columns: 1fr; gap: 1.5rem; } .editorial-item:nth-child(even) .editorial-image { order: 0; } }
</style>
