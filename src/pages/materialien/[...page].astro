---
import DefaultLayout from '../../layouts/DefaultLayout.astro'
import { Card, Pagination } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const materials = await getCollection('materials')
  const sorted = materials.sort((a, b) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  )
  return paginate(sorted, { pageSize: 9 })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'materials'>>
}

const { page } = Astro.props
---

<DefaultLayout
  title="Materialien & Ressourcen"
  description="Ressourcen, Tools und Guides für Gründerinnen und Gründer"
  url="materialien"
>
  <section class="my-12">
    <div class="space-content container">
      <h1>Materialien & Ressourcen</h1>
      <p class="text-2xl">
        Tools, Guides und Frameworks für deinen Gründerweg.
      </p>
    </div>
  </section>

  <section class="my-12">
    <div class="container">
      <p class="text-sm"><em>Ressource {page.start + 1} bis {page.end + 1} von {page.total} Ressourcen</em></p>
      <ul class="my-3">
        {page.data.map((material) => (
          <li>
            <Card
              class="material-card"
              url={'/materialien/' + material.id}
              title={material.data.title}
              footer={material.data.tag + (material.data.author ? ' · ' + material.data.author : '')}
              img={material.data.image}
            >
              {material.data.description}
            </Card>
          </li>
        ))}
      </ul>
      <div class="mt-12 grid place-content-center">
        <Pagination
          firstPage={page.url.prev ? '/materialien' : null}
          previousPage={page.url.prev ? page.url.prev : null}
          nextPage={page.url.next ? page.url.next : null}
          lastPage={page.url.next ? `/materialien/${Math.ceil(page.total / page.size)}` : null}
          currentPage={page.currentPage}
          totalPages={Math.ceil(page.total / page.size)}
        />
      </div>
    </div>
  </section>
</DefaultLayout>

<style lang="scss">
  ul {
    display: grid;
    grid-template-columns: 1fr;
    grid-gap: 2rem;

    @media (min-width: 550px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (min-width: 950px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .material-card {
    background-color: var(--dark-100);
    border: 3px solid var(--gradient-100);
    border-radius: 1rem;
    box-shadow: rgba(0, 0, 0, 0.3) 0px 19px 38px, rgba(0, 0, 0, 0.22) 0px 15px 12px;
  }
</style>
