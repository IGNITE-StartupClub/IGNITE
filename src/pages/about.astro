---
import DefaultLayout from '../layouts/DefaultLayout.astro'
import { Icon } from 'astro-icon/components'
import Feature from '../components/Feature.astro'

export const prerender = true

const structureElements = [
  {
    id: 1,
    icon: 'ion:people-outline',
    title: 'Team',
    description: 'Das operative Herz von IGNITE. Unsere engagierten Studierenden gestalten aktiv die Initiative durch projektbezogene Teams in den Bereichen Events, Workshops, Podcast, Community-Building und mehr.'
  },
  {
    id: 2,
    icon: 'ion:bulb-outline',
    title: 'Advisory Board',
    description: 'Erfahrene Gründer:innen, Alumni und Expert:innen, die uns mit strategischem Rat, Netzwerk und Mentoring zur Seite stehen. Sie verbinden uns mit der erweiterten Startup-Szene.'
  },
  {
    id: 3,
    icon: 'ion:flame-outline',
    title: 'Community',
    description: 'Alle gründungsinteressierten Studierenden der Leuphana. Unser Netzwerk aus ambitionierten Menschen, die gemeinsam lernen, sich vernetzen und die Startup-Kultur leben.'
  }
]
---

<DefaultLayout
  title="Über uns - IGNITE Startup Club"
  description="Wir sind die Anlaufstelle für gründungsinteressierte Studenten an der Leuphana. Lerne mehr über unsere Mission, Struktur und wie wir die Startup-Kultur fördern."
>
  <!-- Hero Section -->
  <section class="hero-section my-24">
    <div class="container">
      <div class="hero-content text-center max-w-4xl mx-auto">
        <h1 class="hero-title text-5xl md:text-7xl font-extrabold mb-6">
          Wer sind wir?
        </h1>
        <p class="hero-subtitle text-2xl md:text-3xl text-neutral-300 leading-relaxed">
          Wir sind die Anlaufstelle für gründungsinteressierte Studenten an der Leuphana.
        </p>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="mission-section my-32">
    <div class="container">
      <div class="mission-content max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
          <div class="mission-text">
            <h2 class="text-4xl md:text-5xl font-bold mb-6 text-gradient">
              Unsere Mission
            </h2>
            <p class="text-xl md:text-2xl text-neutral-300 leading-relaxed mb-6">
              Als studentische Initiative bestehen wir aus drei Elementen:
              <span class="font-semibold text-white">Team</span>,
              <span class="font-semibold text-white">Advisory Board</span> und
              <span class="font-semibold text-white">Community</span>.
            </p>
            <p class="text-lg text-neutral-400 leading-relaxed">
              Gemeinsam schaffen wir ein Ökosystem, das Gründungsgeist fördert,
              Wissen vermittelt und ein starkes Netzwerk für alle aufbaut,
              die ihre unternehmerischen Ideen verwirklichen möchten.
            </p>
          </div>
          <div class="mission-visual">
            <div class="visual-card">
              <div class="visual-inner">
                <Icon name="ion:rocket-outline" class="w-32 h-32 mx-auto text-primary-300" />
                <div class="gradient-blur"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Do Section -->
  <section class="what-we-do-section my-32">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-4xl md:text-5xl font-bold mb-12 text-center">
          Was wir machen
        </h2>
        <div class="activity-card spotlight-card">
          <div class="flex flex-col md:flex-row gap-8 items-center">
            <div class="icon-container">
              <Icon name="ion:people-circle-outline" class="w-24 h-24 text-secondary-200" />
            </div>
            <div class="flex-1">
              <h3 class="text-2xl md:text-3xl font-bold mb-4">
                Vernetzung & Events
              </h3>
              <p class="text-lg md:text-xl text-neutral-300 leading-relaxed">
                Wir besuchen und veranstalten Events, bei denen sich Studierende der Leuphana
                untereinander und mit der erweiterten Startup-Szene aus Lüneburg & Hamburg vernetzen.
                Von Workshops über Hackathons bis hin zum IGNITE Podcast – wir schaffen Räume für
                Austausch, Lernen und Zusammenarbeit.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Structure Section - Bento Grid -->
  <section class="structure-section my-32">
    <div class="container">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-6xl font-bold mb-6">
          Unsere Struktur
        </h2>
        <p class="text-xl text-neutral-400 max-w-3xl mx-auto">
          Drei Säulen, die zusammen IGNITE ausmachen
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 max-w-6xl mx-auto">
        {structureElements.map((element) => (
          <Feature icon={element.icon} title={element.title}>
            {element.description}
          </Feature>
        ))}
      </div>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="cta-section my-32">
    <div class="container">
      <div class="cta-card spotlight-card max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Bereit, Teil von IGNITE zu werden?
        </h2>
        <p class="text-xl text-neutral-300 mb-8 max-w-2xl mx-auto">
          Egal ob du Mitglied im Team werden, unser Advisory Board unterstützen
          oder einfach zur Community gehören möchtest – bei uns bist du richtig.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a class="button secondary size-large has-icon" href="/mitmachen">
            <Icon name="ion:people-outline" />
            Jetzt mitmachen
          </a>
          <a class="button color-secondary size-large has-icon" href="/kontakt">
            <Icon name="ion:mail-outline" />
            Kontakt aufnehmen
          </a>
        </div>
      </div>
    </div>
  </section>
</DefaultLayout>

<style lang="scss">
  @use '../assets/scss/base/breakpoint' as *;

  // Hero Section
  .hero-section {
    position: relative;
    overflow: hidden;

    &::before {
      content: '';
      position: absolute;
      top: -50%;
      left: 50%;
      transform: translateX(-50%);
      width: 800px;
      height: 800px;
      background: radial-gradient(circle, rgba(82, 39, 255, 0.15) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
      animation: pulseGlow 8s ease-in-out infinite;
    }
  }

  .hero-title {
    background: linear-gradient(
      135deg,
      var(--primary-300) 0%,
      var(--secondary-200) 50%,
      var(--primary-400) 100%
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: fadeInUp 0.8s ease-out;
  }

  .hero-subtitle {
    animation: fadeInUp 0.8s ease-out 0.2s both;
  }

  // Mission Section
  .mission-section {
    position: relative;
  }

  .text-gradient {
    background: linear-gradient(
      to right,
      var(--primary-300),
      var(--secondary-200)
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .mission-text {
    animation: fadeInLeft 0.8s ease-out;
  }

  .mission-visual {
    animation: fadeInRight 0.8s ease-out;
  }

  .visual-card {
    position: relative;
    padding: 3rem;
    border-radius: 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border: 2px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    overflow: hidden;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(
        circle at center,
        rgba(82, 39, 255, 0.1),
        transparent 70%
      );
      animation: rotateGradient 10s linear infinite;
    }
  }

  .visual-inner {
    position: relative;
    z-index: 2;
  }

  .gradient-blur {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 200px;
    height: 200px;
    background: radial-gradient(
      circle,
      rgba(140, 57, 116, 0.3),
      transparent 70%
    );
    filter: blur(40px);
    border-radius: 50%;
    animation: pulse 4s ease-in-out infinite;
  }

  // What We Do Section
  .activity-card {
    position: relative;
    padding: 3rem;
    border-radius: 1.5rem;
    background-color: var(--dark-100);
    border: 3px solid var(--gradient-100);
    box-shadow: rgba(0, 0, 0, 0.3) 0px 19px 38px, rgba(0, 0, 0, 0.22) 0px 15px 12px;
    transition: all 0.3s ease;
    overflow: hidden;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      background-color: var(--dark-100);
      border-radius: inherit;
      z-index: 1;
    }

    > * {
      position: relative;
      z-index: 2;
    }

    &:hover::before {
      background: radial-gradient(
        600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(255, 159, 252, 0.15),
        transparent 40%
      ), var(--dark-100);
    }

    &:hover {
      transform: translateY(-4px);
      border-color: var(--primary-300);
      box-shadow:
        rgba(0, 0, 0, 0.4) 0px 25px 50px,
        rgba(0, 0, 0, 0.3) 0px 20px 25px,
        0 0 0 1px rgba(255, 255, 255, 0.1);
    }
  }

  .icon-container {
    flex-shrink: 0;
  }

  // Structure Section
  .structure-section {
    position: relative;
  }

  // CTA Section
  .cta-card {
    position: relative;
    padding: 4rem 2rem;
    border-radius: 2rem;
    background-color: var(--dark-100);
    border: 3px solid var(--gradient-100);
    box-shadow: rgba(0, 0, 0, 0.3) 0px 19px 38px, rgba(0, 0, 0, 0.22) 0px 15px 12px;
    transition: all 0.3s ease;
    overflow: hidden;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      background-color: var(--dark-100);
      border-radius: inherit;
      z-index: 1;
    }

    > * {
      position: relative;
      z-index: 2;
    }

    &:hover::before {
      background: radial-gradient(
        800px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(82, 39, 255, 0.15),
        transparent 40%
      ), var(--dark-100);
    }

    &:hover {
      transform: translateY(-4px);
      border-color: var(--primary-300);
      box-shadow:
        rgba(0, 0, 0, 0.4) 0px 25px 50px,
        rgba(0, 0, 0, 0.3) 0px 20px 25px,
        0 0 0 1px rgba(255, 255, 255, 0.1);
    }
  }

  // Animations
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes fadeInRight {
    from {
      opacity: 0;
      transform: translateX(30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes pulseGlow {
    0%, 100% {
      opacity: 0.3;
      transform: translateX(-50%) scale(1);
    }
    50% {
      opacity: 0.5;
      transform: translateX(-50%) scale(1.1);
    }
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.3;
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 0.6;
      transform: translate(-50%, -50%) scale(1.2);
    }
  }

  @keyframes rotateGradient {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  // Responsive adjustments
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.5rem;
    }

    .activity-card,
    .cta-card {
      padding: 2rem 1.5rem;
    }
  }

  // Performance optimizations
  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  // Spotlight effect for cards
  function initSpotlight() {
    const cards = document.querySelectorAll('.spotlight-card');

    cards.forEach(card => {
      card.removeEventListener('mousemove', card._spotlightHandler);

      card._spotlightHandler = (e) => {
        const rect = card.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;

        card.style.setProperty('--mouse-x', `${x}%`);
        card.style.setProperty('--mouse-y', `${y}%`);
      };

      card.addEventListener('mousemove', card._spotlightHandler);
    });
  }

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSpotlight);
  } else {
    initSpotlight();
  }

  // Re-initialize for Astro view transitions
  document.addEventListener('astro:page-load', initSpotlight);
</script>
