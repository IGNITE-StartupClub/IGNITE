---
/**
 * Base page shell: head (SEO, hreflang alternates, favicons, analytics, theme bootstrap), skip link,
 * Header, <main id="main-content">, Footer.
 * Locale: taken from the URL (Astro.currentLocale); sets <html lang>, defaults and the language toggle target.
 * Props: title, description, url, image, author, noindex (all optional, defaults from siteMeta),
 * alternatePath (the equivalent page in the other language: omitted = derived from the URL, null = no counterpart,
 * so the toggle links to the other home page and no hreflang tags are written), bare (no Header and Footer, for pages
 * that bring their own slim top bar, such as the members login).
 * Data source: getCopy() in src/data/copy.ts.
 */
import '../styles/global.css'
import '../assets/scss/globals.scss'
import { Seo } from 'astro-seo-meta'
import SiteMeta from '../components/SiteMeta.astro'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import { getCopy } from '../data/copy'
import { localizePath, resolveLocale, switchLocalePath } from '../lib/i18n'

interface Props {
  title?: string
  description?: string
  url?: string | URL
  image?: string
  author?: string
  noindex?: boolean
  alternatePath?: string | null
  bare?: boolean
}

const locale = resolveLocale(Astro.currentLocale)
const { navigation, siteMeta } = getCopy(locale)
const {
  title = siteMeta.title,
  description = siteMeta.description,
  url = Astro.site,
  image = '/og-image.jpg',
  author = siteMeta.author,
  noindex = false,
  alternatePath,
  bare = false,
} = Astro.props

const otherLocale = locale === 'de' ? 'en' : 'de'
const otherPath = alternatePath === undefined ? switchLocalePath(Astro.url.pathname, otherLocale) : alternatePath
const alternates = otherPath === null ? [] : [
  { hreflang: locale, href: new URL(Astro.url.pathname, Astro.site).href },
  { hreflang: otherLocale, href: new URL(otherPath, Astro.site).href },
]
const germanAlternate = alternates.find((alternate) => alternate.hreflang === 'de')
---

<html lang={locale} dir="ltr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script is:inline>
      // Sets the theme before first paint to avoid a flash.
      ;(function () {
        var theme = 'light'
        try {
          var stored = localStorage.getItem('theme')
          if (stored === 'light' || stored === 'dark') theme = stored
          else if (window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark'
        } catch (e) {}
        document.documentElement.dataset.theme = theme
        document.documentElement.style.colorScheme = theme
        // Keep the chosen theme across view transitions.
        document.addEventListener('astro:before-swap', function (e) {
          var current = document.documentElement
          e.newDocument.documentElement.dataset.theme = current.dataset.theme
          e.newDocument.documentElement.style.colorScheme = current.dataset.theme
        })
      })()
    </script>

    <Seo keywords={siteMeta.keywords} />
    <SiteMeta title={title} description={description.substring(0, 100)} url={url} image={image} author={author} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    {germanAlternate && <link rel="alternate" hreflang="x-default" href={germanAlternate.href} />}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#0c0b0e" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <script async src="https://plausible.io/js/pa-8RFRHH2yFxceEm9sT_OoQ.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-button focus:bg-primary focus:px-6 focus:py-3 focus:text-primary-fg"
    >
      {navigation.skipLinkLabel}
    </a>
    {!bare && <Header switchHref={otherPath ?? localizePath('/', otherLocale)} />}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>
