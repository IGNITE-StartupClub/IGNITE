---
/**
 * Base page shell: head (SEO, favicons, analytics, theme bootstrap), skip link,
 * Header, <main id="main-content">, Footer.
 * Props: title, description, url, image, author, noindex (all optional, German defaults).
 * Data source: navigation/footer content from src/data/staticContent.ts.
 */
import '../styles/global.css'
import '../assets/scss/globals.scss'
import { Seo } from 'astro-seo-meta'
import SiteMeta from '../components/SiteMeta.astro'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import { navigation } from '../data/staticContent'

interface Props {
  title?: string
  description?: string
  url?: string | URL
  image?: string
  author?: string
  noindex?: boolean
}

const {
  title = 'IGNITE Startup Club Lueneburg',
  description = 'IGNITE ist die studentische Initiative für Entrepreneurship an der Leuphana Universität Lüneburg.',
  url = Astro.site,
  image = '/og-image.jpg',
  author = 'IGNITE Startup Club Lueneburg',
  noindex = false,
} = Astro.props
---

<html lang="de" dir="ltr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script is:inline>
      // Sets the theme before first paint to avoid a flash.
      ;(function () {
        var theme = 'light'
        try {
          var stored = localStorage.getItem('theme')
          if (stored === 'light' || stored === 'dark') theme = stored
          else if (window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark'
        } catch (e) {}
        document.documentElement.dataset.theme = theme
        document.documentElement.style.colorScheme = theme
        // Keep the chosen theme across view transitions.
        document.addEventListener('astro:before-swap', function (e) {
          var current = document.documentElement
          e.newDocument.documentElement.dataset.theme = current.dataset.theme
          e.newDocument.documentElement.style.colorScheme = current.dataset.theme
        })
      })()
    </script>

    <Seo
      keywords={["Startup", "Lüneburg", "Studentische Initiative", "Leuphana", "Universität", "Entrepreneurship", "Innovation", "Business", "Netzwerk", "Mentoring", "Community", "Workshops", "Pitch", "Gründung"]}/>
    <SiteMeta title={title} description={description.substring(0, 100)} url={url} image={image} author={author} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#0c0b0e" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <script async src="https://plausible.io/js/pa-8RFRHH2yFxceEm9sT_OoQ.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-button focus:bg-primary focus:px-6 focus:py-3 focus:text-primary-fg"
    >
      {navigation.skipLinkLabel}
    </a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
