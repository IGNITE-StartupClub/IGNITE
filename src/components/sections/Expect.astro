---
/**
 * "Was dich erwartet" as a bento grid. Mobile: stacked list. md: two columns. lg: six-column bento where
 * Workshops spans the full width (with a real event photo) and the three remaining cards share the row below.
 * Layout comes from `features[].layout` ('wide' | 'half' | 'third') in staticContent.ts.
 * Props: none. Data: features, homepage.featuresHeading / featuresPhotoAlt.
 */
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import Section from '../ui/Section.astro'
import Card from '../ui/Card.astro'
import Button from '../ui/Button.astro'
import { features, homepage } from '../../data/staticContent'
import guide from '../../assets/photos/guide.jpg'

const items = [...features].sort((a, b) => a.order - b.order)
const span: Record<string, string> = {
  wide: 'md:col-span-2 lg:col-span-6',
  half: 'lg:col-span-2',
  third: 'lg:col-span-3',
}
---

<Section id="angebot" tone="subtle" spacing="md" labelledby="expect-title">
  <h2 id="expect-title" class="max-w-text text-display-md" set:html={homepage.featuresHeading} />
  <ul class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-6 lg:gap-5">
    {
      items.map((item) => (
        <Card
          as="li"
          class={`h-full [&_.card-body]:flex [&_.card-body]:flex-1 [&_.card-body]:flex-col ${span[item.layout] ?? ''}`}
        >
          <Icon slot="icon" name={item.icon} aria-hidden="true" />
          <h3 slot="title">{item.title}</h3>
          {item.layout === 'wide' ? (
            <div class="grid gap-6 lg:grid-cols-2">
              <div class="flex h-full flex-col items-start gap-5">
                <p class="lg:my-auto">{item.description}</p>
                {item.link && (
                  <Button href={item.link.href} variant="outline">
                    {item.link.label}
                  </Button>
                )}
              </div>
              <Image
                src={guide}
                alt={homepage.featuresPhotoAlt}
                widths={[384, 640, 960, 1280]}
                sizes="(min-width: 1152px) 528px, (min-width: 1024px) 46vw, calc(100vw - 96px)"
                format="webp"
                quality={82}
                loading="lazy"
                class="aspect-[16/9] w-full rounded-xl object-cover"
              />
            </div>
          ) : (
            <>
              <p>{item.description}</p>
              {!item.link && (
                <Icon name={item.icon} class="mt-auto h-12 w-12 self-end text-accent opacity-30" aria-hidden="true" />
              )}
              {item.link && (
                <div class="mt-auto pt-4">
                  <Button href={item.link.href} variant="outline">
                    {item.link.label}
                  </Button>
                </div>
              )}
            </>
          )}
        </Card>
      ))
    }
  </ul>
</Section>
