---
/**
 * "Warum" statement in the theresidency pattern: a large statement heading (one serif accent word), short paragraphs in
 * large body text with one serif-italic emphasis phrase (<em> in the copy), then a single "Für wen" card with three
 * plain lines (no bullets or icons).
 * A quiet KPI proof row (numbers + labels, no cards) follows the paragraphs.
 * Props: none. Data: kpiData, homepage (whyHeading, whyParagraphs, audienceHeading, audienceLines) in staticContent.ts.
 */
import Section from '../ui/Section.astro'
import Card from '../ui/Card.astro'
import { homepage } from '../../data/staticContent'
import { kpiData } from '../../data/kpiData'

const format = new Intl.NumberFormat('de-DE')
---

<Section spacing="md" labelledby="why-title" class="why-section">
  <h2 id="why-title" class="max-w-wide text-display-md" set:html={homepage.whyHeading} />
  <div class="em-inline mt-10 max-w-text space-y-7 text-lead text-fg-muted md:mt-12">
    {homepage.whyParagraphs.map((text) => <p set:html={text} />)}
  </div>
  <dl class="mt-14 grid max-w-text grid-cols-2 gap-x-8 gap-y-7 border-t border-border pt-8 sm:grid-cols-4" aria-label={homepage.heroKpiLabel}>
    {
      kpiData.map((kpi) => (
        <div class="flex flex-col-reverse gap-1">
          <dt class="text-sm text-fg-muted">{kpi.label}</dt>
          <dd class="text-xl font-semibold leading-none tracking-display">
            {format.format(kpi.value)}
            {kpi.suffix ?? ''}
          </dd>
        </div>
      ))
    }
  </dl>
  <div class="audience-composition">
    <Card class="audience-card">
      <h3 slot="title" class="text-display-sm" set:html={homepage.audienceHeading} />
      <div class="space-y-4 text-lead text-fg">
        {homepage.audienceLines.map((line) => <p>{line}</p>)}
      </div>
    </Card>
    <figure class="why-figure">
      <img src="/img/heritage/saltbag-laptop.png" alt="Offener Laptop auf einem mit Lüneburger Salz gefüllten Jutesack" width="1312" height="1199" loading="lazy" decoding="async" />
    </figure>
  </div>
</Section>

<style>
  .audience-composition {
    display: grid;
    grid-template-columns: minmax(0, var(--container-text)) minmax(11rem, 15rem);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    max-width: 57rem;
    margin-top: clamp(5rem, 8vw, 6rem);
  }

  .why-figure {
    display: grid;
    place-items: center;
    margin: 0;
  }

  .why-figure img {
    display: block;
    width: 100%;
    max-height: 17rem;
    object-fit: contain;
  }

  @media (max-width: 639px) {
    .audience-composition {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      margin-top: 4rem;
    }

    .why-figure {
      justify-self: end;
      width: min(72vw, 15rem);
      margin-right: 0.5rem;
    }

    .why-figure img {
      max-height: 12rem;
    }
  }
</style>
