---
/**
 * "Warum" statement in the theresidency pattern: a large statement heading (one serif accent word), short paragraphs in
 * large body text with one serif-italic emphasis phrase (<em> in the copy), followed by an open audience band.
 * The shared-work sculpture supports the community statement.
 * Props: none. Data: homepage (whyHeading, whyParagraphs, audienceHeading, audienceLines) in staticContent.ts.
 */
import Section from '../ui/Section.astro'
import { homepage } from '../../data/staticContent'
---

<Section spacing="md" labelledby="why-title" class="why-section">
  <h2 id="why-title" class="max-w-wide text-display-md" set:html={homepage.whyHeading} />
  <div class="em-inline mt-10 max-w-text space-y-7 text-lead text-fg-muted md:mt-12">
    {homepage.whyParagraphs.map((text) => <p set:html={text} />)}
  </div>
  <figure class="community-figure">
    <img src="/img/heritage/salt-sculpture.png" alt="Zwei Marmorskulpturen entwickeln gemeinsam eine Idee am Laptop" width="1536" height="1024" loading="lazy" decoding="async" />
  </figure>
</Section>

<Section spacing="sm" labelledby="audience-title" class="audience-band border-y border-border">
  <div class="audience-layout">
    <div class="audience-intro">
      <h2 id="audience-title" class="text-display-sm" set:html={homepage.audienceHeading} />
    </div>
    <div class="audience-lines text-lead">
      {homepage.audienceLines.map((line) => <p>{line}</p>)}
    </div>
  </div>
</Section>

<style>
  .community-figure { display: grid; place-items: center; margin: 2rem 0 0; }
  .community-figure img { display: block; width: min(100%, 36rem); height: auto; }
  .audience-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .audience-lines p {
    margin: 0;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .audience-lines p:first-child { padding-top: 0; }
  .audience-lines p:last-child { padding-bottom: 0; border-bottom: 0; }
  @media (max-width: 767px) {
    .audience-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    .audience-intro h2 { text-align: center; }
  }
</style>
