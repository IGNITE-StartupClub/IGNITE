---
/**
 * Neuigkeiten as before: heading with lead, then the newest `projects` entry featured as image left, text right,
 * gradient-outline "Mehr lesen!" button. A ghost link leads to the full list.
 * Props: none. Data: projects collection (title, description, author, date, image), homepage (news*) in staticContent.ts.
 */
import { getCollection } from 'astro:content'
import Section from '../ui/Section.astro'
import Button from '../ui/Button.astro'
import { homepage } from '../../data/staticContent'

const [latest] = (await getCollection('projects')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const formatDate = (date: Date) =>
  date.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })
---

<Section tone="subtle" spacing="md" labelledby="news-title">
  <h2 id="news-title" class="text-display-md" set:html={homepage.newsHeading} />
  <p class="mt-4 text-lead text-fg-muted">{homepage.newsLead}</p>
  {
    latest && (
      <article class="mt-12 grid items-center gap-8 md:grid-cols-2 md:gap-16">
        <img
          src={latest.data.image}
          alt={`${homepage.newsImageAltPrefix} ${latest.data.title}`}
          width="800"
          height="600"
          loading="lazy"
          class="aspect-[4/3] w-full rounded-2xl object-cover shadow-[var(--shadow-card)]"
        />
        <div class="flex flex-col items-start gap-5">
          <h3 class="text-display-sm">{latest.data.title}</h3>
          <p class="text-lead text-fg-muted">{latest.data.description}</p>
          <p class="text-sm text-fg-muted">
            {homepage.newsAuthorLabel} {latest.data.author} ·{' '}
            <time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time>
          </p>
          <div class="mt-2 flex flex-wrap items-center gap-x-8 gap-y-4">
            <Button href={`/news/${latest.id}/`} variant="secondary" size="lg" icon="ion:reader-outline">
              {homepage.newsReadMore}
            </Button>
            <Button href={homepage.newsCTA_URL} variant="ghost">
              {homepage.newsCTA_Text}
            </Button>
          </div>
        </div>
      </article>
    )
  }
</Section>
