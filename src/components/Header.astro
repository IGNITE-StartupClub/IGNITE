---
import Navigation from '../components/Navigation.astro'
import { DarkMode } from 'accessible-astro-components'
import { SkipLink } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { navigation } from '../data/staticContent'

// Static navigation data
const menuItems = navigation.menuItems
---

<header style="z-index: 100;">
  <SkipLink />
  <Navigation>
    {menuItems.map((item) => (
      item.children && item.children.length > 0 ? (
        <li class="menu-item has-dropdown">
          <button aria-haspopup="true" aria-expanded="false">{item.label}</button>
          <ul class="dropdown-menu">
            {item.children.map((child) => (
              <li class="submenu-item">
                <a
                  href={child.url}
                  rel={child.isExternal ? 'external' : undefined}
                  target={child.isExternal ? '_blank' : undefined}
                >
                  {child.label}
                </a>
              </li>
            ))}
          </ul>
        </li>
      ) : (
        <li class="menu-item">
          <a
            href={item.url}
            rel={item.isExternal ? 'external' : undefined}
            target={item.isExternal ? '_blank' : undefined}
          >
            {item.label}
          </a>
        </li>
      )
    ))}
  </Navigation>
</header>

<style lang="scss" is:global>
  @use '../assets/scss/base/outline' as *;

  header {
    .type-icon a {
      display: block;

      [data-icon] {
        margin-top: -4px;
        width: 30px;
        height: auto;

        path {
          fill: var(--action-color);
        }
      }

      &:hover {
        [data-icon] path {
          fill: var(--action-color-state);
        }
      }
    }
  }
</style>
