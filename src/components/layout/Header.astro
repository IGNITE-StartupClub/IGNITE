---
/**
 * Floating pill navigation. Desktop (lg+): logo, centered links (Events as dropdown), theme and language toggle, the
 * members area link and the primary "Mitmachen" pill (kept outermost). Below lg: logo, small Mitmachen pill and a menu button that opens MobileNav (fullscreen overlay).
 * Inside the members area (signed in; the login page has no header) the pill switches: "IGNITE Member" logo linking to
 * the members home, the member navigation (memberArea.nav) and a profile menu with photo instead of the members link
 * and "Mitmachen".
 * Props: switchHref (URL of the equivalent page in the other language, target of the language toggle).
 * The pill gets slightly more compact after scrolling (data-scrolled). The header is fixed and takes no layout space;
 * `main` reserves the room (global.css). Active page gets aria-current="page".
 * With a mouse, a highlight stretches between the links and the pill grows slightly while hovered; both states survive navigation.
 * Data source: navigation and memberArea.nav via getCopy() (src/data/copy.ts), the member's photo via members.ts.
 */
import { Icon } from 'astro-icon/components'
import Logo from '../Logo.astro'
import Button from '../ui/Button.astro'
import ThemeToggle from '../ui/ThemeToggle.astro'
import LanguageToggle from '../ui/LanguageToggle.astro'
import MemberLink from '../ui/MemberLink.astro'
import MobileNav from './MobileNav.astro'
import { getCopy } from '../../data/copy'
import { photoPath } from '../../lib/emailSignature'
import { resolveLocale } from '../../lib/i18n'
import { memberAreaLocale, memberHomePath, memberPagePath } from '../../lib/memberAuth'
import { photoIdOf } from '../../lib/members'

interface Props {
  switchHref: string
}

interface NavItem {
  label: string
  url: string
  isExternal?: boolean
  children?: NavItem[]
}

const { switchHref } = Astro.props
const locale = resolveLocale(Astro.currentLocale)
const { navigation, memberArea } = getCopy(locale)
const memberNav = memberArea.nav
// Set by the middleware on every members area page that needs a session.
const member = memberAreaLocale(Astro.url.pathname) ? Astro.locals.member : undefined
const photoId = member ? await photoIdOf(member.email) : null
const memberHome = memberHomePath(locale)
const items: NavItem[] = member
  ? [
      { label: memberNav.home, url: memberHome },
      { label: memberNav.signature, url: memberPagePath('signature', locale) },
      { label: memberNav.guide, url: memberNav.guideUrl },
      { label: memberNav.mentoring, url: memberNav.mentoringUrl, isExternal: true },
    ]
  : [...navigation.menuItems].sort((a, b) => a.order - b.order)
const trim = (path: string) => (path.length > 1 ? path.replace(/\/$/, '') : path)
const currentPath = trim(Astro.url.pathname)
const home = trim(member ? memberHome : navigation.homeUrl)
const isCurrent = (url: string) => url !== '#' && (currentPath === trim(url) || (trim(url) !== home && currentPath.startsWith(`${trim(url)}/`)))
---

<header class="site-header" data-site-header transition:animate="none">
  <div class="pill">
    <a
      href={member ? memberHome : navigation.homeUrl}
      class="logo-link"
      aria-label={member ? `${navigation.logoText} ${memberNav.badge}` : navigation.logoText}
    >
      <Logo color="currentColor" name={navigation.logoText} />
      {member && <span class="member-badge" aria-hidden="true">{memberNav.badge}</span>}
    </a>

    <nav class="main-nav hidden lg:block" aria-label={member ? memberNav.label : navigation.mainNavLabel} data-main-nav>
      <span class="nav-indicator" aria-hidden="true" data-nav-indicator></span>
      <ul class="flex items-center gap-1">
        {items.map((item) => (
          <li class="relative">
            {'children' in item && item.children ? (
              <details class="nav-dropdown">
                <summary class="nav-link" data-active={item.children.some((c) => isCurrent(c.url)) || undefined}>
                  {item.label}
                  <svg class="chevron" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                    <path d="m2.5 4.5 3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                <ul class="nav-panel">
                  {item.children.map((child, i) => (
                    <li style={`--i: ${i}`}>
                      <a class="panel-link" href={child.url} aria-current={isCurrent(child.url) ? 'page' : undefined}>
                        {child.label}
                        <svg class="panel-arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                          <path d="M3 8h9m-3.5-3.5L12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a
                class="nav-link"
                href={item.url}
                aria-current={isCurrent(item.url) ? 'page' : undefined}
                target={item.isExternal ? '_blank' : undefined}
                rel={item.isExternal ? 'noopener noreferrer' : undefined}
              >
                {item.label}
                {item.isExternal && (
                  <>
                    <svg class="external" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
                      <path d="M4 2.5h5.5V8M9.5 2.5 2.5 9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="sr-only">({memberNav.newTab})</span>
                  </>
                )}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      <div class="hidden items-center gap-1 lg:flex">
        <LanguageToggle href={switchHref} />
        <ThemeToggle />
        {!member && <MemberLink />}
      </div>
      {
        member ? (
          <details class="nav-dropdown profile-menu">
            <summary class="profile-trigger" aria-label={memberNav.profile}>
              {photoId ? (
                <img src={photoPath(photoId)} alt="" width="36" height="36" />
              ) : (
                <Icon name="ion:person-outline" aria-hidden="true" />
              )}
            </summary>
            <ul class="nav-panel profile-panel">
              <li class="profile-account" style="--i: 0">
                {memberNav.signedInAs}
                <strong>{member.email}</strong>
              </li>
              {member.role === 'admin' && (
                <li style="--i: 1">
                  <a class="panel-link" href={memberPagePath('admin', locale)} aria-current={isCurrent(memberPagePath('admin', locale)) ? 'page' : undefined}>
                    {memberNav.admin}
                  </a>
                </li>
              )}
              <li style="--i: 2">
                <a class="panel-link" href={`${memberPagePath('login', locale)}?reset`}>{memberNav.password}</a>
              </li>
              <li style="--i: 3">
                <a class="panel-link" href={navigation.homeUrl}>{memberNav.website}</a>
              </li>
              <li style="--i: 4">
                <form method="post" action="/api/members/logout">
                  <input type="hidden" name="locale" value={locale} />
                  <button type="submit" class="panel-link logout">{memberNav.logout}</button>
                </form>
              </li>
            </ul>
          </details>
        ) : (
          <Button href={navigation.ctaUrl} size="sm">{navigation.ctaLabel}</Button>
        )
      }
      <button
        type="button"
        class="menu-trigger lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={navigation.menuOpenLabel}
        data-label-open={navigation.menuOpenLabel}
        data-label-close={navigation.menuCloseLabel}
      >
        <span class="menu-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<MobileNav items={items} switchHref={switchHref} isCurrentPaths={items.flatMap((i) => ('children' in i && i.children ? i.children : [i])).filter((i) => isCurrent(i.url)).map((i) => i.url)} />

<script>
  import type { TransitionBeforeSwapEvent } from 'astro:transitions/client'

  // Compact pill after scrolling; closes the desktop dropdown on Escape or outside click.
  // With a mouse, a highlight glides between the links and dropdowns open on hover.
  // ViewTransitions swaps the header on every navigation, so element listeners are bound again on astro:page-load.
  const onScroll = () => document.querySelector('[data-site-header]')?.toggleAttribute('data-scrolled', window.scrollY > 24)
  window.addEventListener('scroll', onScroll, { passive: true })

  const CLOSE_ANIMATION_MS = 120
  const closeDropdown = (d: HTMLDetailsElement) => {
    if (!d.open || d.hasAttribute('data-closing')) return
    d.setAttribute('data-closing', '')
    setTimeout(() => {
      d.open = false
      d.removeAttribute('data-closing')
    }, CLOSE_ANIMATION_MS)
  }
  const closeDropdowns = (except?: Element | null) => {
    document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown[open]').forEach((d) => d !== except && closeDropdown(d))
  }
  document.addEventListener('click', (e) => closeDropdowns((e.target as Element).closest('.nav-dropdown')))
  document.addEventListener('keydown', (e) => e.key === 'Escape' && closeDropdowns())

  // Hover lives in attributes instead of :hover: after a header swap, :hover only returns with the next pointer move,
  // so the pill would shrink and grow again on every click. The state is carried into the new header before the swap.
  // During a view transition the overlay is hit-tested instead of the page, so pointer events would clear the state.
  const inTransition = () => document.documentElement.hasAttribute('data-astro-transition')
  document.addEventListener('pointerover', (e) => {
    if (inTransition()) return
    const target = e.target as Element
    document.querySelector('.pill')?.toggleAttribute('data-hovered', !!target.closest('.pill'))
    if (!target.closest('[data-main-nav]')) document.querySelector('[data-nav-indicator]')?.removeAttribute('data-visible')
  })
  document.addEventListener('pointerout', (e) => {
    if (e.relatedTarget || inTransition()) return
    document.querySelector('.pill')?.removeAttribute('data-hovered')
    document.querySelector('[data-nav-indicator]')?.removeAttribute('data-visible')
  })
  document.addEventListener('astro:before-swap', (e) => {
    const next = (e as TransitionBeforeSwapEvent).newDocument
    if (document.querySelector('.pill')?.hasAttribute('data-hovered')) next.querySelector('.pill')?.setAttribute('data-hovered', '')
    // onScroll on astro:page-load then animates the compact pill back if the new page starts at the top.
    if (document.querySelector('[data-site-header]')?.hasAttribute('data-scrolled')) next.querySelector('[data-site-header]')?.setAttribute('data-scrolled', '')
    const indicator = document.querySelector('[data-nav-indicator]')
    const nextIndicator = next.querySelector('[data-nav-indicator]')
    if (indicator?.hasAttribute('data-visible') && nextIndicator) {
      nextIndicator.setAttribute('style', indicator.getAttribute('style') ?? '')
      nextIndicator.setAttribute('data-visible', '')
    }
  })

  const initNav = () => {
    onScroll()
    const nav = document.querySelector<HTMLElement>('[data-main-nav]')
    const indicator = document.querySelector<HTMLElement>('[data-nav-indicator]')
    if (!nav || !indicator || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) return

    nav.setAttribute('data-indicator', '')
    const moveIndicator = (link: HTMLElement) => {
      const navRect = nav.getBoundingClientRect()
      const rect = link.getBoundingClientRect()
      const left = rect.left - navRect.left
      const previousLeft = parseFloat(indicator.style.getPropertyValue('--l'))
      // The edge in the direction of travel moves first, so the highlight stretches and catches up.
      indicator.dataset.dir = left < previousLeft ? 'left' : 'right'
      indicator.style.setProperty('--l', `${left}px`)
      indicator.style.setProperty('--r', `${navRect.right - rect.right}px`)
      if (!indicator.hasAttribute('data-visible')) {
        // Appear in place instead of sliding in from the last position.
        void indicator.offsetWidth
        indicator.setAttribute('data-visible', '')
      }
    }
    const hideIndicator = () => indicator.removeAttribute('data-visible')
    const release = () => indicator.removeAttribute('data-pressed')
    nav.addEventListener('pointerover', (e) => {
      const link = (e.target as Element).closest<HTMLElement>('.nav-link')
      if (link) moveIndicator(link)
    })
    nav.addEventListener('pointerleave', release)
    nav.addEventListener('pointerdown', (e) => (e.target as Element).closest('.nav-link') && indicator.setAttribute('data-pressed', ''))
    nav.addEventListener('pointerup', release)
    nav.addEventListener('pointercancel', release)
    nav.addEventListener('focusin', (e) => {
      const link = (e.target as Element).closest<HTMLElement>('.nav-link')
      if (link?.matches(':focus-visible')) moveIndicator(link)
    })
    nav.addEventListener('focusout', (e) => !nav.contains(e.relatedTarget as Node) && hideIndicator())

    nav.querySelectorAll<HTMLDetailsElement>('.nav-dropdown').forEach((d) => {
      const item = d.parentElement as HTMLElement
      let closeTimer: ReturnType<typeof setTimeout> | undefined
      item.addEventListener('pointerenter', () => {
        clearTimeout(closeTimer)
        d.removeAttribute('data-closing')
        closeDropdowns(d)
        d.open = true
      })
      item.addEventListener('pointerleave', () => {
        closeTimer = setTimeout(() => closeDropdown(d), 180)
      })
      // Hover already opened it; a mouse click must not toggle it shut. Keyboard clicks (detail 0) still toggle.
      d.querySelector('summary')?.addEventListener('click', (e) => e.detail > 0 && e.preventDefault())
    })
  }
  // Fires on the first load as well as after every client-side navigation.
  document.addEventListener('astro:page-load', initNav)
</script>

<style>
  .site-header {
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    position: fixed;
    top: 0.75rem;
    inset-inline: 0;
    z-index: 50;
    padding-inline: 0.75rem;
    pointer-events: none;
  }
  .pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    max-width: var(--container-wide);
    min-height: 3.75rem;
    margin-inline: auto;
    padding: 0.25rem 0.5rem 0.25rem 1.25rem;
    background-color: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    box-shadow: 0 8px 32px rgb(0 0 0 / 0.12);
    transition:
      min-height 0.5s var(--ease-out),
      margin-top 0.5s var(--ease-out),
      background-color 0.4s ease,
      border-color 0.4s ease,
      box-shadow 0.5s ease;
  }
  [data-scrolled] .pill {
    min-height: 3.25rem;
  }
  /* The pill answers the pointer: it morphs a little taller on hover, evenly up and down so the links stay put. */
  @media (hover: hover) and (pointer: fine) {
    .pill[data-hovered] {
      min-height: 4.125rem;
      margin-top: -0.1875rem;
      background-color: color-mix(in srgb, var(--color-bg) 92%, transparent);
      border-color: color-mix(in srgb, var(--color-fg) 16%, transparent);
      box-shadow: 0 16px 48px rgb(0 0 0 / 0.22);
    }
    [data-scrolled] .pill[data-hovered] {
      min-height: 3.625rem;
    }
  }
  .logo-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-logo);
  }
  .logo-link :global(svg) {
    transition: transform 0.3s var(--ease-out);
  }
  .logo-link:hover {
    color: var(--color-logo);
  }
  .logo-link:active :global(svg) {
    transform: scale(0.97);
  }
  .member-badge {
    margin-left: 0.625rem;
    padding: 0.125rem 0.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-accent-text);
    border: 1px solid currentColor;
    border-radius: 999px;
  }
  .main-nav {
    position: relative;
  }
  .external {
    opacity: 0.7;
  }
  /* Shared hover highlight; JS sets --l/--r (distance to the nav edges) to the hovered link. */
  .nav-indicator {
    position: absolute;
    top: 50%;
    left: var(--l, 0);
    right: var(--r, 100%);
    height: 2.75rem;
    border-radius: 999px;
    background-color: var(--color-bg-subtle);
    opacity: 0;
    transform: translateY(-50%) scale(0.96);
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .nav-indicator[data-visible] {
    opacity: 1;
    transform: translateY(-50%);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      left 0.4s var(--ease-out),
      right 0.4s var(--ease-out);
  }
  .nav-indicator[data-visible][data-pressed] {
    transform: translateY(-50%) scale(0.96);
  }
  /* Liquid stretch: the leading edge runs ahead, the trailing edge catches up. */
  .nav-indicator[data-visible][data-dir='right'] {
    transition-duration: 0.2s, 0.2s, 0.6s, 0.3s;
  }
  .nav-indicator[data-visible][data-dir='left'] {
    transition-duration: 0.2s, 0.2s, 0.3s, 0.6s;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-fg-muted);
    cursor: pointer;
    list-style: none;
    border-radius: 999px;
    transition:
      color var(--duration-fast) ease,
      background-color var(--duration-fast) ease,
      transform 0.3s var(--ease-out);
  }
  /* Quick press, soft release. */
  .nav-link:active {
    transform: scale(0.96);
    transition-duration: var(--duration-fast), var(--duration-fast), 0.1s;
  }
  .nav-link:hover,
  .nav-link[aria-current='page'],
  .nav-link[data-active],
  .nav-dropdown[open] > .nav-link {
    color: var(--color-fg);
  }
  .main-nav:not([data-indicator]) .nav-link:hover,
  .nav-link[aria-current='page'],
  .nav-link[data-active],
  .main-nav:not([data-indicator]) .nav-dropdown[open] > .nav-link {
    background-color: var(--color-bg-subtle);
  }
  .nav-link[aria-current='page']::before,
  .nav-link[data-active]::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background-color: var(--color-primary);
  }
  summary.nav-link::-webkit-details-marker {
    display: none;
  }
  .chevron {
    transition: transform 0.3s var(--ease-out);
  }
  .nav-dropdown[open]:not([data-closing]) .chevron {
    transform: rotate(180deg);
  }
  .nav-panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    min-width: 15rem;
    padding: 0.375rem;
    transform: translateX(-50%);
    transform-origin: top center;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.25);
    animation: panel-in 0.25s var(--ease-out);
    transition:
      opacity 0.12s ease,
      transform 0.12s ease;
  }
  /* Bridges the gap to the summary so the pointer can cross it without closing the panel. */
  .nav-panel::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 100%;
    height: 0.75rem;
  }
  .nav-dropdown[data-closing] .nav-panel {
    opacity: 0;
    transform: translateX(-50%) translateY(-4px) scale(0.98);
  }
  .nav-panel > li {
    animation: panel-item-in 0.3s ease backwards;
    animation-delay: calc(var(--i) * 35ms + 40ms);
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(-6px) scale(0.96);
    }
  }
  @keyframes panel-item-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  .panel-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    font-size: var(--text-sm);
    border-radius: 0.875rem;
    color: var(--color-fg-muted);
    transition:
      color var(--duration-fast) ease,
      background-color var(--duration-fast) ease,
      padding var(--duration-fast) ease;
  }
  .panel-link:hover,
  .panel-link[aria-current='page'] {
    color: var(--color-fg);
    background-color: var(--color-bg-subtle);
  }
  .panel-link:hover {
    padding-left: 1.25rem;
  }
  .panel-arrow {
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity var(--duration-fast) ease,
      transform 0.25s var(--ease-out);
  }
  .panel-link:hover .panel-arrow,
  .panel-link:focus-visible .panel-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .profile-menu {
    position: relative;
  }
  .profile-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-fg);
    list-style: none;
    cursor: pointer;
    border-radius: 999px;
    transition:
      background-color var(--duration-fast) ease,
      transform 0.25s var(--ease-out);
  }
  .profile-trigger::-webkit-details-marker {
    display: none;
  }
  .profile-trigger:hover,
  .profile-menu[open] > .profile-trigger {
    background-color: var(--color-bg-subtle);
  }
  .profile-trigger:active {
    transform: scale(0.96);
  }
  .profile-trigger img {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    object-fit: cover;
  }
  .profile-trigger :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }
  /* Right-aligned under the trigger; the shared panel is centered, which would overflow the pill's right edge. */
  .profile-panel {
    left: auto;
    right: 0;
    transform: none;
    transform-origin: top right;
    animation-name: profile-panel-in;
  }
  .profile-menu[data-closing] .profile-panel {
    transform: translateY(-4px) scale(0.98);
  }
  @keyframes profile-panel-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.96);
    }
  }
  .profile-account {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.625rem 1rem 0.75rem;
    margin-bottom: 0.375rem;
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    border-bottom: 1px solid var(--color-border);
  }
  .profile-account strong {
    font-weight: 500;
    color: var(--color-fg);
    overflow-wrap: anywhere;
  }
  /* The site's base styles give every button a border, padding and line-height 1. */
  .logout {
    width: 100%;
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1.5;
    text-align: left;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .pill :global(.btn) {
    transition:
      background-color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      transform 0.25s var(--ease-out);
  }
  .pill :global(.btn:active) {
    transform: scale(0.96);
  }
  .menu-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: var(--color-fg);
    background: transparent;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
  }
  .menu-bars,
  .menu-bars::before {
    display: block;
    width: 1.25rem;
