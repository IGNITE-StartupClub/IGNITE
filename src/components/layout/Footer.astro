---
/**
 * Site footer: logo with claim and newsletter on the left, link columns (Navigation, Rechtliches) on the right,
 * bottom bar with copyright and social icon links. Calm and compact, no oversized wordmark.
 * Data source: navigation, footer, globalConfig in src/data/staticContent.ts.
 */
import { Icon } from 'astro-icon/components'
import Logo from '../Logo.astro'
import NewsletterForm from '../forms/NewsletterForm'
import { footer, globalConfig, navigation } from '../../data/staticContent'

const year = new Date().getFullYear()
const navLinks = [...navigation.menuItems]
  .sort((a, b) => a.order - b.order)
  .flatMap((item) => ('children' in item && item.children ? item.children : [item]))
const groups = [
  { heading: footer.navigationHeading, links: navLinks },
  { heading: footer.legalHeading, links: footer.legalLinks },
]
---

<footer class="border-t border-border bg-bg text-fg" aria-label={footer.footerNavLabel}>
  <div class="mx-auto max-w-wide px-gutter pb-8 pt-section-sm">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr_1fr] lg:gap-16">
      <div class="flex max-w-text flex-col gap-5">
        <a href="/" class="text-logo hover:text-logo" aria-label={navigation.logoText}><Logo color="currentColor" name={navigation.logoText} /></a>
        <p class="text-sm text-fg-muted">{footer.description}</p>
        {footer.showNewsletter && <NewsletterForm client:visible />}
      </div>

      {
        groups.map((group) => (
          <nav aria-label={group.heading}>
            <h2 class="mb-3 font-sans text-sm font-semibold tracking-normal text-fg-subtle">{group.heading}</h2>
            <ul class="flex flex-col">
              {group.links.map((link) => (
                <li>
                  <a class="inline-flex min-h-11 items-center text-fg-muted transition-colors hover:text-fg" href={link.url}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-section-sm flex flex-col gap-4 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-fg-subtle">&copy; {year} {globalConfig.copyrightText}</p>
      <ul class="flex items-center gap-1" aria-label={footer.socialHeading}>
        {
          footer.socialLinks.map((s) => (
            <li>
              <a
                class="inline-flex h-11 w-11 items-center justify-center rounded-button text-fg-muted transition-colors hover:text-fg"
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.platform}
              >
                <Icon name={s.icon} class="h-6 w-6" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
