---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  src: string
  alt: string
  width: number
  height: number
  widths?: number[]
  sizes?: string
  loading?: 'eager' | 'lazy'
  fetchpriority?: 'high' | 'low' | 'auto'
  decoding?: 'async' | 'sync' | 'auto'
  class?: string
}

// Preserve public asset URLs in content data; use imported sources for build-time optimization.
const sources = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/optimized-sources/**/*.{png,jpg,jpeg,JPG,webp}',
  { eager: true },
)
const { src, alt, width, height, widths = [320, 640, 960], sizes = '100vw', loading = 'lazy', fetchpriority = 'auto', class: className } = Astro.props
const source = sources[`../../assets/optimized-sources${src}`]?.default
const outputWidth = source ? Math.min(width, source.width) : width
const outputHeight = source ? Math.round(outputWidth * source.height / source.width) : height
const responsiveWidths = source ? [...new Set(widths.map((size) => Math.min(size, source.width)))] : widths
---

{source ? (
  <Image src={source} {alt} width={outputWidth} height={outputHeight} widths={responsiveWidths} {sizes} format="webp" quality={82} {loading} {fetchpriority} decoding="async" class={className} />
) : (
  <img {src} {alt} {width} {height} {loading} {fetchpriority} decoding="async" class={className} />
)}
