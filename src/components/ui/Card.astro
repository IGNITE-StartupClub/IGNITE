---
/**
 * The one Card for the whole site: dark (or white) surface, hairline border that turns into the brand gradient on hover,
 * rounded 1rem, soft mouse-follow highlight and a small lift on hover (pointer devices only).
 * Slots: icon (white icon in a solid brand circle), media (image/avatar), title (heading element),
 * meta (role, date), default (body copy).
 * Props: as (wrapper tag, 'article' | 'div' | 'li'), class. Render a link inside the title slot, never around the card.
 * All colors come from tokens, so it works in both themes.
 */
interface Props {
  as?: 'article' | 'div' | 'li'
  class?: string
}

const { as: Tag = 'article', class: className = '' } = Astro.props
const hasIcon = Astro.slots.has('icon')
const hasMedia = Astro.slots.has('media')
const hasTitle = Astro.slots.has('title')
const hasMeta = Astro.slots.has('meta')
---

<Tag class:list={['card', className]}>
  {hasIcon && <div class="card-icon"><slot name="icon" /></div>}
  {hasMedia && <div class="card-media"><slot name="media" /></div>}
  {hasTitle && <div class="card-title"><slot name="title" /></div>}
  {hasMeta && <div class="card-meta"><slot name="meta" /></div>}
  <div class="card-body"><slot /></div>
</Tag>

<style>
  .card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    overflow: hidden;
    color: var(--color-fg);
    border: 1px solid transparent;
    border-radius: var(--radius-card);
    background:
      linear-gradient(var(--color-card), var(--color-card)) padding-box,
      linear-gradient(var(--color-border), var(--color-border)) border-box;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  /* Mouse-follow highlight; position is set by the script below. */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      var(--color-card-spotlight),
      transparent 40%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  @media (hover: hover) {
    .card:hover {
      background:
        linear-gradient(var(--color-card), var(--color-card)) padding-box,
        var(--gradient-brand) border-box;
      transform: translateY(-2px);
      box-shadow: var(--shadow-card-hover);
    }
    .card:hover::before {
      opacity: 1;
    }
  }
  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    color: var(--color-icon-fg);
    background-color: var(--color-icon-bg);
  }
  .card-icon :global(svg) {
    width: 1.75rem;
    height: 1.75rem;
  }
  .card-media {
    overflow: hidden;
    border-radius: calc(var(--radius-card) - 0.25rem);
  }
  .card-media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .card-title {
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .card-title :global(:is(h2, h3, h4)) {
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
  }
  .card-meta {
    margin-top: -0.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent-text);
  }
  .card-body {
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-fg-muted);
  }
  .card-body:empty {
    display: none;
  }
  @media (min-width: 768px) {
    .card {
      padding: 2rem;
    }
  }
</style>

<script>
  // Feeds the highlight position to the hovered card. Skipped for touch and reduced motion.
  const canHover = window.matchMedia('(hover: hover)').matches
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (canHover && !reduced) {
    document.addEventListener('pointermove', (event) => {
      const card = (event.target as Element | null)?.closest<HTMLElement>('.card')
      if (!card) return
      const rect = card.getBoundingClientRect()
      card.style.setProperty('--mouse-x', `${((event.clientX - rect.left) / rect.width) * 100}%`)
      card.style.setProperty('--mouse-y', `${((event.clientY - rect.top) / rect.height) * 100}%`)
    })
  }
</script>
