---
/**
 * Simple previous/next pagination for Astro's paginate() pages.
 * Props: page (Astro Page object), basePath (list root, e.g. '/news'), label (nav aria-label, defaults to commonUi.pagination.label).
 */
import type { Page } from 'astro'
import { getCopy } from '../../data/copy'

interface Props {
  page: Page<unknown>
  basePath: string
  label?: string
}

const { commonUi } = getCopy(Astro.currentLocale)
const { page, basePath, label = commonUi.pagination.label } = Astro.props
const prev = page.url.prev ? (page.currentPage === 2 ? basePath : page.url.prev) : null
const total = Math.ceil(page.total / page.size)
const linkClass =
  'inline-flex min-h-11 items-center rounded-button border border-border-strong px-6 text-fg transition-colors hover:border-fg hover:bg-bg-subtle'
---

{
  total > 1 && (
    <nav aria-label={label} class="mt-16 flex items-center justify-between gap-4">
      {prev ? <a href={prev} rel="prev" class={linkClass}>{commonUi.pagination.previous}</a> : <span />}
      <p class="text-sm text-fg-muted">{commonUi.pagination.pageOf(page.currentPage, total)}</p>
      {page.url.next ? <a href={page.url.next} rel="next" class={linkClass}>{commonUi.pagination.next}</a> : <span />}
    </nav>
  )
}
