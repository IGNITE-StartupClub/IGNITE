---
/**
 * Breadcrumb trail. Props: items ({ label, href? }, the last item is the current page).
 */
interface Item {
  label: string
  href?: string
}
interface Props {
  items: Item[]
}

const { items } = Astro.props
---

<nav aria-label="Brotkrumen" class="text-sm text-fg-muted">
  <ol class="flex flex-wrap gap-x-2">
    {
      items.map((item, i) => (
        <li class="flex gap-2">
          {item.href ? (
            <a href={item.href} class="underline underline-offset-4 hover:text-fg">{item.label}</a>
          ) : (
            <span aria-current="page" class="text-fg">{item.label}</span>
          )}
          {i < items.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
