---
/**
 * Loading screen on the way from the public site into the members area, shown to signed-in members only. Visitors
 * without a session go straight to the login page as before. A purple circle grows from the clicked link, the ring
 * around the mark spins while the server answers and closes once the member page has arrived, then the screen opens
 * from its centre and shows the page.
 * Links opt in with `data-member-entry`. The public pages are prerendered and the session cookie is httpOnly, so the
 * browser cannot see a session when the link is clicked: it remembers the last sign-in in localStorage (HINT_KEY) and
 * forgets it on logout or when the server answers with the login page after all.
 * Rendered by DefaultLayout on every page, because the swap drops the styles of components the new page does not use.
 * Copy: memberArea.login.portal and memberArea.login.card.done.title via getCopy() (src/data/copy.ts).
 */
import Logo from '../Logo.astro'
import { getCopy } from '../../data/copy'
import { resolveLocale } from '../../lib/i18n'

const { memberArea, navigation } = getCopy(resolveLocale(Astro.currentLocale))
const { login } = memberArea
---

<template data-member-portal>
  <div class="member-portal surface-brand">
    <div class="portal-mark">
      <svg class="portal-ring" viewBox="0 0 100 100" aria-hidden="true">
        <circle class="portal-track" cx="50" cy="50" r="48" pathLength="100"></circle>
        <circle class="portal-arc" cx="50" cy="50" r="48" pathLength="100"></circle>
      </svg>
      <Logo color="currentColor" name={navigation.logoText} markOnly />
    </div>
    <p class="portal-label" role="status" data-ready={login.card.done.title}>{login.portal}</p>
  </div>
</template>

<script>
  import type { TransitionBeforePreparationEvent, TransitionBeforeSwapEvent } from 'astro:transitions/client'

  const HINT_KEY = 'ignite_member_hint'
  // Long enough to read as a step of its own when the server answers at once.
  const MIN_LOADING_MS = 500
  const READY_MS = 380

  // Blocked storage only costs the animation: the link then works like any other.
  const hasHint = () => {
    try {
      return localStorage.getItem(HINT_KEY) === '1'
    } catch {
      return false
    }
  }
  const setHint = (signedIn: boolean) => {
    try {
      if (signedIn) localStorage.setItem(HINT_KEY, '1')
      else localStorage.removeItem(HINT_KEY)
    } catch {}
  }

  const isMemberPage = (doc: Document) => !!doc.querySelector('[data-main-nav][data-member]')
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))

  let portal: HTMLElement | null = null

  const openPortal = (link: Element) => {
    const template = document.querySelector<HTMLTemplateElement>('template[data-member-portal]')
    const element = template?.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined
    if (!element) throw new Error('MemberPortal template is missing')
    // The mobile menu hides the link before this runs, then the circle grows from the centre (the CSS default).
    const { left, top, width, height } = link.getBoundingClientRect()
    if (width) {
      element.style.setProperty('--x', `${left + width / 2}px`)
      element.style.setProperty('--y', `${top + height / 2}px`)
    }
    // Outside <body>, because the router replaces <body> and the running animations have to survive the swap.
    document.documentElement.append(element)
    portal = element
  }

  const showReady = () => {
    if (!portal) return
    const label = portal.querySelector<HTMLElement>('.portal-label')
    if (label) label.textContent = label.dataset.ready ?? ''
    portal.dataset.state = 'ready'
  }

  const closePortal = async () => {
    if (!portal) return
    const closing = portal
    portal = null
    closing.dataset.state = 'leaving'
    await Promise.allSettled(closing.getAnimations().map((animation) => animation.finished))
    closing.remove()
  }

  document.addEventListener('astro:before-preparation', (e) => {
    const event = e as TransitionBeforePreparationEvent
    const link = event.sourceElement?.closest('[data-member-entry]')
    if (!link || !hasHint()) return

    openPortal(link)
    event.signal.addEventListener('abort', closePortal)
    const load = event.loader
    event.loader = async () => {
      await Promise.all([load(), wait(MIN_LOADING_MS)])
      // A failed request makes the router load the page the classic way, which replaces the portal as well.
      if (event.defaultPrevented || event.signal.aborted) return
      if (isMemberPage(event.newDocument)) {
        showReady()
        await wait(READY_MS)
      } else {
        setHint(false)
      }
    }
  })

  // The portal already covers the page, a crossfade underneath would only delay it.
  document.addEventListener('astro:before-swap', (e) => {
    if (!portal) return
    const { viewTransition } = e as TransitionBeforeSwapEvent
    // Skipping rejects `ready` with an AbortError by design, and nothing here waits for it.
    viewTransition.ready.catch(() => {})
    viewTransition.skipTransition()
  })

  document.addEventListener('astro:page-load', () => {
    if (isMemberPage(document)) setHint(true)
    closePortal()
  })

  document.addEventListener('submit', (e) => {
    if ((e.target as Element).matches('form[action="/api/members/logout"]')) setHint(false)
  })

  // After a failed request the back button can restore this page from the bfcache, portal included.
  window.addEventListener('pageshow', (e) => e.persisted && closePortal())
</script>

<style>
  /* Registered so the radius can animate; negative so the soft edge of the opening stays out of sight at the start. */
  @property --portal-hole {
    syntax: '<length>';
    inherits: false;
    initial-value: -64px;
  }
  /* Sits outside <body>, so nothing from the body styles reaches it. */
  .member-portal {
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    place-items: center;
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-body);
    background-image: radial-gradient(circle at center, color-mix(in srgb, var(--color-brand-bright) 45%, transparent), transparent 60%);
    animation: portal-grow 0.55s var(--ease-out) both;
  }
  .member-portal[data-state='leaving'] {
    pointer-events: none;
    mask-image: radial-gradient(circle at center, transparent var(--portal-hole), #000 calc(var(--portal-hole) + 64px));
    animation: portal-open 0.6s cubic-bezier(0.6, 0, 0.3, 1) forwards;
  }
  @keyframes portal-grow {
    from {
      clip-path: circle(0 at var(--x, 50%) var(--y, 50%));
    }
    to {
      clip-path: circle(150vmax at var(--x, 50%) var(--y, 50%));
    }
  }
  /* 72vmax just passes the corners of a square window, so the movement stays visible until the end. */
  @keyframes portal-open {
    to {
      --portal-hole: 72vmax;
    }
  }
  .portal-mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 7.5rem;
    height: 7.5rem;
    animation: portal-content-in 0.45s var(--ease-out) 0.12s both;
  }
  .portal-mark :global(.logo) {
    width: 3.75rem;
  }
  .portal-ring {
    position: absolute;
    inset: 0;
    fill: none;
    stroke-width: 2.5;
  }
  .portal-track {
    stroke: var(--color-border);
  }
  .portal-arc {
    stroke: var(--color-fg);
    stroke-linecap: round;
    stroke-dasharray: 22 100;
    transform-origin: center;
    transition: stroke-dasharray 0.3s ease;
    animation: portal-spin 0.9s linear infinite;
  }
  .portal-label {
    position: absolute;
    top: calc(50% + 5.25rem);
    inset-inline: var(--space-gutter);
    margin: 0;
    font-size: var(--text-sm);
    text-align: center;
    color: var(--color-fg-muted);
    animation: portal-content-in 0.45s var(--ease-out) 0.2s both;
  }
  [data-state='ready'] .portal-arc,
  [data-state='leaving'] .portal-arc {
    stroke-dasharray: 100 100;
  }
  [data-state='ready'] .portal-mark :global(.logo) {
    animation: portal-pop 0.38s var(--ease-out);
  }
  [data-state='ready'] .portal-label {
    color: var(--color-fg);
    animation: portal-label-in 0.25s ease both;
  }
  [data-state='leaving'] .portal-label {
    color: var(--color-fg);
  }
  [data-state='leaving'] .portal-mark,
  [data-state='leaving'] .portal-label {
    animation: portal-content-out 0.25s ease both;
  }
  @keyframes portal-content-in {
    from {
      opacity: 0;
      transform: scale(0.86);
    }
  }
  @keyframes portal-content-out {
    to {
      opacity: 0;
      transform: scale(1.1);
    }
  }
  @keyframes portal-label-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  @keyframes portal-pop {
    40% {
      transform: scale(1.1);
    }
  }
  @keyframes portal-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
