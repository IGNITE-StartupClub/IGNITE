---
import { Avatar } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'

// Get first 3 events, sorted by date
const allEvents = await getCollection('events')
const events = allEvents.sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime()).slice(0, 3)
---

<section class="my-24">
  <div class="space-content container">
    <h2
      class="mb-4 bg-gradient-to-br from-[var(--primary-300)] via-[var(--secondary-200)] to-[var(--primary-400)] bg-clip-text text-4xl text-transparent md:text-6xl"
    >
      Nächste Events
    </h2>
    <p class="text-xl text-gray-300 md:text-2xl">Das steht als nächstes an!</p>
  </div>
</section>

